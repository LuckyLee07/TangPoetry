长","zhǎng"],["风","fēng"],["。",""]],[["诏","zhào"],["谓","wèi"],["将","jiāng"],["军","jūn"],["拂","fú"],["绢","juàn"],["素","sù"],["，",""]],[["意","yì"],["匠","jiàng"],["惨","cǎn"],["淡","dàn"],["经","jīng"],["营","yíng"],["中","zhōng"],["；",""]],[["斯","sī"],["须","xū"],["九","jiǔ"],["重","chóng"],["真","zhēn"],["龙","lóng"],["出","chū"],["，",""]],[["一","yī"],["洗","xǐ"],["万","wàn"],["古","gǔ"],["凡","fán"],["马","mǎ"],["空","kōng"],["。",""]],[["玉","yù"],["花","huā"],["却","què"],["在","zài"],["御","yù"],["榻","tà"],["上","shàng"],["，",""]],[["榻","tà"],["上","shàng"],["庭","tíng"],["前","qián"],["屹","yì"],["相","xiāng"],["向","xiàng"],["；",""]],[["至","zhì"],["尊","zūn"],["含","hán"],["笑","xiào"],["催","cuī"],["赐","cì"],["金","jīn"],["，",""]],[["圉","yǔ"],["人","rén"],["太","tài"],["仆","pū"],["皆","jiē"],["惆","chóu"],["怅","chàng"],["，",""]],[["弟","dì"],["子","zǐ"],["韩","hán"],["干","gàn"],["早","zǎo"],["入","rù"],["室","shì"],["，",""]],[["亦","yì"],["能","néng"],["画","huà"],["马","mǎ"],["穷","qióng"],["殊","shū"],["相","xiāng"],["；",""]],[["干","gàn"],["惟","wéi"],["画","huà"],["肉","ròu"],["不","bù"],["画","huà"],["骨","gǔ"],["，",""]],[["忍","rěn"],["使","shǐ"],["骅","huá"],["骝","liú"],["气","qì"],["凋","diāo"],["丧","sàng"],["。",""]],[["将","jiāng"],["军","jūn"],["画","huà"],["善","shàn"],["盖","gài"],["有","yǒu"],["神","shén"],["，",""]],[["偶","ǒu"],["逢","féng"],["佳","jiā"],["士","shì"],["亦","yì"],["写","xiě"],["真","zhēn"],["；",""]],[["即","jí"],["今","jīn"],["漂","piāo"],["泊","bó"],["干","gān"],["戈","gē"],["际","jì"],["，",""]],[["屡","lǚ"],["貌","mào"],["寻","xún"],["常","cháng"],["行","xíng"],["路","lù"],["人","rén"],["。",""]],[["涂","tú"],["穷","qióng"],["反","fǎn"],["遭","zāo"],["俗","sú"],["眼","yǎn"],["白","bái"],["，",""]],[["世","shì"],["上","shàng"],["未","wèi"],["有","yǒu"],["如","rú"],["公","gōng"],["贫","pín"],["；",""]],[["但","dàn"],["看","kàn"],["古","gǔ"],["来","lái"],["盛","shèng"],["名","míng"],["下","xià"],["，",""]],[["终","zhōng"],["日","rì"],["坎","kǎn"],["𡒄",""],["缠","chán"],["其","qí"],["身","shēn"],["。",""]]],"noteTitle":"诗意","note":"曹霸以画笔让功臣与骏马重获神采，曾备受赏识，如今却在战乱中漂泊贫困。诗人既赞其艺术，也叹才名与命运的错落。","interpretation":["将军是曹操后裔，如今虽成平民，先人的文采风流仍在。他曾习书，遗憾未能超越王羲之，后来专心绘画，忘了老之将至，把富贵看得很轻。","开元年间，他常受召入宫，为凌烟阁功臣画像重添神采。文臣冠服、武将大箭，都被画得鲜活，猛将仿佛还在战阵中。","先帝命画玉花骢，许多画工不得其神，曹将军潜心构思，顷刻画出真龙般的骏马，画中马与庭前真马相对而立，君王笑着赐金。弟子韩干也擅长画马，但诗人认为他较重形肉，尚未尽传骏骨。","曹将军也为佳士画像，如今战乱漂泊，只好屡画普通路人。穷困时反受世俗冷眼；想到古来有大名的人，往往一生坎坷，更为你的贫苦不平。"],"annotations":[{"text":"意匠：创作中的构思经营。","source":"编辑释义"},{"text":"画骨：不只是画外形，更要表现内在精神气质。","source":"编辑释义"},{"text":"王右军：即王羲之。","source":"chiuinan"},{"text":"丹青：图画。","source":"chiuinan"},{"text":"凌烟：阁名，贞观十七年，图功臣于其阁。","source":"chiuinan"},{"text":"褒公：即段志玄。","source":"chiuinan"},{"text":"鄂公：即尉迟敬德。","source":"chiuinan"},{"text":"墀：音\"池\"，阶上的平地。","source":"chiuinan"},{"text":"阊阖：音\"昌合\"，紫薇宫门名。","source":"chiuinan"},{"text":"九重：称帝王居所。","source":"chiuinan"},{"text":"玉花：即玉花骢，玄宗良马。","source":"chiuinan"},{"text":"圉人、太仆：掌养马事官名。圉，音\"雨\"。","source":"chiuinan"},{"text":"骅骝：音\"华留\"，古良马名。","source":"chiuinan"},{"text":"坎𡒄：穷困、境遇不顺。𡒄，音\"览\"。","source":"chiuinan"}],"variants":[{"text":"又作途","textTraditional":"又作途","source":"ctext","sourceUrl":"https://ctext.org/wiki.pl?if=en&chapter=820428","originalLine":"又作途","originalLineTraditional":"又作途","locationStatus":"source-does-not-identify-target"}],"preface":[],"notes":["意匠：创作中的构思经营。","画骨：不只是画外形，更要表现内在精神气质。","王右军：即王羲之。","丹青：图画。","凌烟：阁名，贞观十七年，图功臣于其阁。","褒公：即段志玄。","鄂公：即尉迟敬德。","墀：音\"池\"，阶上的平地。","阊阖：音\"昌合\"，紫薇宫门名。","九重：称帝王居所。","玉花：即玉花骢，玄宗良马。","圉人、太仆：掌养马事官名。圉，音\"雨\"。","骅骝：音\"华留\"，古良马名。","坎𡒄：穷困、境遇不顺。𡒄，音\"览\"。"],"contentStatus":"editorial-draft","sourceTitle":"丹青引赠曹霸将军","layout":"center-low"}
