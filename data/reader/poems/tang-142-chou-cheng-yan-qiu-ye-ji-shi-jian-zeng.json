{"id":"tang-142-chou-cheng-yan-qiu-ye-ji-shi-jian-zeng","title":"酬程延秋夜即事见赠","author":"韩翃","rubyLines":[[["长","zhǎng"],["簟","diàn"],["迎","yíng"],["风","fēng"],["早","zǎo"],["，",""]],[["空","kōng"],["城","chéng"],["澹","dàn"],["月","yuè"],["华","huá"],["。",""]],[["星","xīng"],["河","hé"],["秋","qiū"],["一","yī"],["雁","yàn"],["，",""]],[["砧","zhēn"],["杵","chǔ"],["夜","yè"],["千","qiān"],["家","jiā"],["。",""]],[["节","jié"],["候","hòu"],["看","kàn"],["应","yīng"],["晚","wǎn"],["，",""]],[["心","xīn"],["期","qī"],["卧","wò"],["亦","yì"],["赊","shē"],["。",""]],[["向","xiàng"],["来","lái"],["吟","yín"],["秀","xiù"],["句","jù"],["，",""]],[["不","bù"],["觉","jué"],["已","yǐ"],["鸣","míng"],["鸦","yā"],["。",""]]],"noteTitle":"诗意","note":"秋夜微凉，雁声、银河与千家砧杵相互映衬。读着友人寄来的好诗，心中相契而难寐，不觉已经听见清晨鸦鸣。","interpretation":["长竹席早早迎来凉风，寂静城中月色清淡。银河旁一声秋雁鸣，千家传来捣衣的砧杵声。","看这时节已经入深秋，即使躺下，心中仍有悠长的期待与牵念。我一直吟读你寄来的佳句，不知不觉已听见乌鸦报晓。"],"annotations":[{"text":"簟：竹席。","source":"编辑释义"},{"text":"砧杵：捣衣所用的石砧与棒槌。","source":"编辑释义"},{"text":"月华：月光。","source":"chiuinan"}],"variants":[],"preface":[],"notes":["簟：竹席。","砧杵：捣衣所用的石砧与棒槌。","月华：月光。"],"contentStatus":"editorial-draft","sourceTitle":"酬程延秋夜即事见赠","layout":"center-low"}
