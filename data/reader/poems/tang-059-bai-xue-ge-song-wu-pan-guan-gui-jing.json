{"id":"tang-059-bai-xue-ge-song-wu-pan-guan-gui-jing","title":"白雪歌送武判官归京","author":"岑参","rubyLines":[[["北","běi"],["风","fēng"],["卷","juǎn"],["地","dì"],["白","bái"],["草","cǎo"],["折","zhé"],["，",""]],[["胡","hú"],["天","tiān"],["八","bā"],["月","yuè"],["即","jí"],["飞","fēi"],["雪","xuě"],["；",""]],[["忽","hū"],["如","rú"],["一","yī"],["夜","yè"],["春","chūn"],["风","fēng"],["来","lái"],["，",""]],[["千","qiān"],["树","shù"],["万","wàn"],["树","shù"],["梨","lí"],["花","huā"],["开","kāi"],["。",""]],[["散","sàn"],["入","rù"],["珠","zhū"],["帘","lián"],["湿","shī"],["罗","luó"],["幕","mù"],["，",""]],[["狐","hú"],["裘","qiú"],["不","bù"],["煖","nuǎn"],["锦","jǐn"],["衾","qīn"],["薄","báo"],["。",""]],[["将","jiāng"],["军","jūn"],["角","jiǎo"],["弓","gōng"],["不","bù"],["得","dé"],["控","kòng"],["，",""]],[["都","dōu"],["护","hù"],["铁","tiě"],["衣","yī"],["冷","lěng"],["犹","yóu"],["著","zhù"],["。",""]],[["瀚","hàn"],["海","hǎi"],["阑","lán"],["干","gān"],["百","bǎi"],["丈","zhàng"],["冰","bīng"],["，",""]],[["愁","chóu"],["云","yún"],["黪","cǎn"],["淡","dàn"],["万","wàn"],["里","lǐ"],["凝","níng"],["。",""]],[["中","zhōng"],["军","jūn"],["置","zhì"],["酒","jiǔ"],["饮","yǐn"],["归","guī"],["客","kè"],["，",""]],[["胡","hú"],["琴","qín"],["琵","pí"],["琶","pá"],["与","yǔ"],["羌","qiāng"],["笛","dí"],["。",""]],[["纷","fēn"],["纷","fēn"],["暮","mù"],["雪","xuě"],["下","xià"],["辕","yuán"],["门","mén"],["，",""]],[["风","fēng"],["掣","chè"],["红","hóng"],["旗","qí"],["冻","dòng"],["不","bù"],["翻","fān"],["。",""]],[["轮","lún"],["台","tái"],["东","dōng"],["门","mén"],["送","sòng"],["君","jūn"],["去","qù"],["，",""]],[["去","qù"],["时","shí"],["雪","xuě"],["满","mǎn"],["天","tiān"],["山","shān"],["路","lù"],["；",""]],[["山","shān"],["回","huí"],["路","lù"],["转","zhuǎn"],["不","bú"],["见","jiàn"],["君","jūn"],["，",""]],[["雪","xuě"],["上","shàng"],["空","kōng"],["留","liú"],["马","mǎ"],["行","xíng"],["处","chù"],["。",""]]],"noteTitle":"诗意","note":"边地八月飞雪，满树如梨花盛开。严寒中设宴送友，路转山回之后人影消失，只有雪上的马蹄痕还牵着离情。","interpretation":["北风卷地，吹折白草，边地八月便下雪，一夜间满树积雪，好像春风吹开千万朵梨花。雪飘入帘幕，裘衣锦被都不够暖，弓难拉开，铠甲冰冷。","沙漠结着纵横厚冰，万里愁云低垂。中军设酒为归客送行，胡琴、琵琶与羌笛一同奏起；傍晚辕门外雪纷纷，红旗冻住，在风里也翻不动。","我在轮台东门送你出发，天山路上已铺满雪。山路回转，终于看不见你的身影，只有雪地上的马蹄痕留在眼前。"],"annotations":[{"text":"瀚海：这里指边地广阔的沙漠。","source":"编辑释义"},{"text":"辕门：军营的门。","source":"编辑释义"},{"text":"梨花：色白，用以喻雪。","source":"chiuinan"},{"text":"衾：音\"琴\"，大衣。","source":"chiuinan"},{"text":"阑干：七横八竖地。","source":"chiuinan"},{"text":"掣：音\"彻\"，牵动。","source":"chiuinan"}],"variants":[{"text":"难着--一作 ：犹著","source":"唐诗三百首.json"}],"preface":[],"notes":["瀚海：这里指边地广阔的沙漠。","辕门：军营的门。","梨花：色白，用以喻雪。","衾：音\"琴\"，大衣。","阑干：七横八竖地。","掣：音\"彻\"，牵动。"],"contentStatus":"editorial-draft","sourceTitle":"白雪歌送武判官归京","layout":"center-low"}
