{"id":"tang-066-shan-shi","title":"山石","author":"韩愈","rubyLines":[[["山","shān"],["石","shí"],["荦","luò"],["确","què"],["行","xíng"],["径","jìng"],["微","wēi"],["，",""]],[["黄","huáng"],["昏","hūn"],["到","dào"],["寺","sì"],["蝙","biān"],["蝠","fú"],["飞","fēi"],["。",""]],[["升","shēng"],["堂","táng"],["坐","zuò"],["阶","jiē"],["新","xīn"],["雨","yǔ"],["足","zú"],["，",""]],[["芭","bā"],["蕉","jiāo"],["叶","yè"],["大","dà"],["栀","zhī"],["子","zi"],["肥","féi"],["。",""]],[["僧","sēng"],["言","yán"],["古","gǔ"],["壁","bì"],["佛","fú"],["画","huà"],["好","hǎo"],["，",""]],[["以","yǐ"],["火","huǒ"],["来","lái"],["照","zhào"],["所","suǒ"],["见","jiàn"],["稀","xī"],["。",""]],[["铺","pū"],["床","chuáng"],["拂","fú"],["席","xí"],["置","zhì"],["羹","gēng"],["饭","fàn"],["，",""]],[["疏","shū"],["粝","lì"],["亦","yì"],["足","zú"],["饱","bǎo"],["我","wǒ"],["饥","jī"],["。",""]],[["夜","yè"],["深","shēn"],["静","jìng"],["卧","wò"],["百","bǎi"],["虫","chóng"],["绝","jué"],["，",""]],[["清","qīng"],["月","yuè"],["出","chū"],["岭","lǐng"],["光","guāng"],["入","rù"],["扉","fēi"],["。",""]],[["天","tiān"],["明","míng"],["独","dú"],["去","qù"],["无","wú"],["道","dào"],["路","lù"],["，",""]],[["出","chū"],["入","rù"],["高","gāo"],["下","xià"],["穷","qióng"],["烟","yān"],["霏","fēi"],["。",""]],[["山","shān"],["红","hóng"],["涧","jiàn"],["碧","bì"],["纷","fēn"],["烂","làn"],["漫","màn"],["，",""]],[["时","shí"],["见","jiàn"],["松","sōng"],["枥","lì"],["皆","jiē"],["十","shí"],["围","wéi"],["。",""]],[["当","dāng"],["流","liú"],["赤","chì"],["足","zú"],["蹋","tà"],["涧","jiàn"],["石","shí"],["，",""]],[["水","shuǐ"],["声","shēng"],["激","jī"],["激","jī"],["风","fēng"],["吹","chuī"],["衣","yī"],["。",""]],[["人","rén"],["生","shēng"],["如","rú"],["此","cǐ"],["自","zì"],["可","kě"],["乐","lè"],["，",""]],[["岂","qǐ"],["必","bì"],["局","jú"],["束","shù"],["为","wéi"],["人","rén"],["鞿","jī"],["？",""]],[["嗟","jiē"],["哉","zāi"],["吾","wú"],["党","dǎng"],["二","èr"],["三","sān"],["子","zi"],["，",""]],[["安","ān"],["得","dé"],["至","zhì"],["老","lǎo"],["不","bù"],["更","gèng"],["归","guī"],["？",""]]],"noteTitle":"诗意","note":"从黄昏投宿山寺到清晨踏涧独行，粗饭、月色与山光都有自在之趣。诗人由此感叹，何必一生受外在事务拘束。","interpretation":["山石高低不平，小路隐约，黄昏到寺时蝙蝠正飞。坐在堂阶上，新雨洗得芭蕉叶宽大、栀子繁盛；僧人持火照看壁画，又铺床备下粗饭菜，已足以饱腹。","夜深虫声也静了，清月越过山岭，光照进门。天明独自出发，在高低山路间穿过烟雾；红花碧涧纷呈，粗大的松树栎树不时出现在眼前。","我赤脚踏着涧石，流水激响，风吹衣裳。这样的生活自有快乐，何必被人事拘束？几位同道朋友啊，怎样才能一直如此，不再返回那受牵累的生活呢？"],"annotations":[{"text":"荦确：山石不平的样子。","source":"编辑释义"},{"text":"鞿：马缰绳，诗中借指拘束。","source":"编辑释义"},{"text":"疏粝：粗饭。","source":"chiuinan"},{"text":"烟霏：烟雾般的云气。","source":"chiuinan"},{"text":"激激：水急流声。","source":"chiuinan"}],"variants":[{"text":"鞿--一作 ：靰","source":"唐诗三百首.json"}],"preface":[],"notes":["荦确：山石不平的样子。","鞿：马缰绳，诗中借指拘束。","疏粝：粗饭。","烟霏：烟雾般的云气。","激激：水急流声。"],"contentStatus":"editorial-draft","sourceTitle":"山石","layout":"center-low"}
