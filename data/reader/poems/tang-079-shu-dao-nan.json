,["。",""]],[["但","dàn"],["见","jiàn"],["悲","bēi"],["鸟","niǎo"],["号","hào"],["古","gǔ"],["木","mù"],["，",""]],[["雄","xióng"],["飞","fēi"],["雌","cí"],["从","cóng"],["绕","rào"],["林","lín"],["间","jiān"],["；",""]],[["又","yòu"],["闻","wén"],["子","zi"],["规","guī"],["啼","tí"],["，",""]],[["夜","yè"],["月","yuè"],["愁","chóu"],["空","kōng"],["山","shān"],["。",""]],[["蜀","shǔ"],["道","dào"],["之","zhī"],["难","nán"],["难","nán"],["于","yú"],["上","shàng"],["青","qīng"],["天","tiān"],["！",""]],[["使","shǐ"],["人","rén"],["听","tīng"],["此","cǐ"],["凋","diāo"],["朱","zhū"],["颜","yán"],["。",""]],[["连","lián"],["峰","fēng"],["去","qù"],["天","tiān"],["不","bù"],["盈","yíng"],["尺","chǐ"],["，",""]],[["枯","kū"],["松","sōng"],["倒","dào"],["挂","guà"],["倚","yǐ"],["绝","jué"],["壁","bì"],["。",""]],[["飞","fēi"],["湍","tuān"],["瀑","pù"],["流","liú"],["争","zhēng"],["喧","xuān"],["豗","huī"],["，",""]],[["砯","pīng"],["崖","yá"],["转","zhuǎn"],["石","shí"],["万","wàn"],["壑","hè"],["雷","léi"],["。",""]],[["其","qí"],["险","xiǎn"],["也","yě"],["如","rú"],["此","cǐ"],["！",""]],[["嗟","jiē"],["尔","ěr"],["远","yuǎn"],["道","dào"],["之","zhī"],["人","rén"],["，",""]],[["胡","hú"],["为","wèi"],["乎","hū"],["来","lái"],["哉","zāi"],["？",""]],[["剑","jiàn"],["阁","gé"],["峥","zhēng"],["嵘","róng"],["而","ér"],["崔","cuī"],["嵬","wéi"],["，",""]],[["一","yī"],["夫","fū"],["当","dāng"],["关","guān"],["，",""]],[["万","wàn"],["夫","fū"],["莫","mò"],["开","kāi"],["；",""]],[["所","suǒ"],["守","shǒu"],["或","huò"],["匪","fěi"],["亲","qīn"],["，",""]],[["化","huà"],["为","wèi"],["狼","láng"],["与","yǔ"],["豺","chái"],["，",""]],[["朝","cháo"],["避","bì"],["猛","měng"],["虎","hǔ"],["，",""]],[["夕","xī"],["避","bì"],["长","zhǎng"],["蛇","shé"],["，",""]],[["磨","mó"],["牙","yá"],["吮","shǔn"],["血","xuè"],["，",""]],[["杀","shā"],["人","rén"],["如","rú"],["麻","má"],["。",""]],[["锦","jǐn"],["城","chéng"],["虽","suī"],["云","yún"],["乐","lè"],["，",""]],[["不","bù"],["如","rú"],["早","zǎo"],["还","hái"],["家","jiā"],["。",""]],[["蜀","shǔ"],["道","dào"],["之","zhī"],["难","nán"],["难","nán"],["于","yú"],["上","shàng"],["青","qīng"],["天","tiān"],["，",""]],[["侧","cè"],["身","shēn"],["西","xī"],["望","wàng"],["常","cháng"],["咨","zī"],["嗟","jiē"],["。",""]]],"noteTitle":"诗意","note":"蜀道的高山、急水与险关层层展开，连鸟兽也难通行。惊叹自然险峻之后，诗人更提醒远行者提防人事之险，早日归家。","interpretation":["蜀道高得令人惊叹，通行之难仿佛上青天。诗中从古蜀开国的传说说起：长久与秦地隔绝，只有高山鸟道；直到山崩地裂、壮士身死，才有栈道连通。","山峰高得使日车回转，下面急水回旋；黄鹤难飞过，猿猴也愁攀援。青泥岭山路盘旋，人仿佛摸到星宿，屏息抚胸，只能长叹。","问远行人何时回来，这险途尽是峭壁，古木间悲鸟回绕，月夜里杜鹃啼叫，使人一听就愁损容颜。连峰逼天，枯松倒挂绝壁，急流瀑布冲岩转石，万谷如雷。远道来的人，为何要到这里？","剑阁高险，一人守关，万人难攻。守关者倘若不可靠，便可能化为豺狼，路上更有虎蛇般的凶险，随时伤人。成都虽说欢乐，不如早些回家；我侧身西望蜀道，仍不住叹息。"],"annotations":[{"text":"蚕丛、鱼凫：古蜀传说中的君主。","source":"编辑释义"},{"text":"剑阁：蜀地险要关隘。","source":"编辑释义"},{"text":"鸟道：飞鸟的路，称险绝的山径。","source":"chiuinan"},{"text":"地崩山摧壮士死：秦惠王许嫁女于蜀王，蜀王遣五力士迎接。至梓潼，遇巨蛇隐于穴，五力士拉之，致山崩成五岭，力士与惠王女俱亡，至此秦蜀道路方通。","source":"chiuinan"},{"text":"猿猱：手足最便捷之猴类。猱，音\"挠\"。","source":"chiuinan"},{"text":"参、井：均为星宿名。","source":"chiuinan"},{"text":"子规：杜鹃，为蜀王望帝杜宇死后所化。","source":"chiuinan"},{"text":"朱颜：称少年人。","source":"chiuinan"},{"text":"喧豗：声音热闹。豗，音\"灰\"。","source":"chiuinan"},{"text":"砯崖：水击岩石声。砯，其音难辨。中文系统作\"拼\"；正业书局\"辞海\"作\"娉\"；大孚书局\"唐诗三百首导读\"作\"窘\"；骆驼出版社\"诗学理论与诠释\"作\"烹\"，各书所列之音均相异。另一容易弄混之字\"砅\"，音\"力\"，履石渡水。","source":"chiuinan"}],"variants":[{"text":"攀援--一作 ：攀缘","source":"唐诗三百首.json"},{"text":"也如此--一作 ：也若此","source":"唐诗三百首.json"}],"preface":[],"notes":["蚕丛、鱼凫：古蜀传说中的君主。","剑阁：蜀地险要关隘。","鸟道：飞鸟的路，称险绝的山径。","地崩山摧壮士死：秦惠王许嫁女于蜀王，蜀王遣五力士迎接。至梓潼，遇巨蛇隐于穴，五力士拉之，致山崩成五岭，力士与惠王女俱亡，至此秦蜀道路方通。","猿猱：手足最便捷之猴类。猱，音\"挠\"。","参、井：均为星宿名。","子规：杜鹃，为蜀王望帝杜宇死后所化。","朱颜：称少年人。","喧豗：声音热闹。豗，音\"灰\"。","砯崖：水击岩石声。砯，其音难辨。中文系统作\"拼\"；正业书局\"辞海\"作\"娉\"；大孚书局\"唐诗三百首导读\"作\"窘\"；骆驼出版社\"诗学理论与诠释\"作\"烹\"，各书所列之音均相异。另一容易弄混之字\"砅\"，音\"力\"，履石渡水。"],"contentStatus":"editorial-draft","sourceTitle":"蜀道难","layout":"center-low"}
