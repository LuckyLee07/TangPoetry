  "poem": {
    "id": "tang-204-xi-sai-shan-huai-gu",
    "order": 204,
    "section": "七言律诗",
    "title": "西塞山怀古",
    "titleTraditional": "西塞山懷古",
    "author": "刘禹锡",
    "authorTraditional": "劉禹錫",
    "dynasty": "唐代",
    "aliases": [
      "西塞山怀古"
    ],
    "lines": [
      "王濬楼船下益州，金陵王气黯然收。",
      "千寻铁锁沈江底，一片降旛出石头。",
      "人世几回伤往事，山形依旧枕寒流。",
      "从今四海为家日，故垒萧萧芦荻秋。"
    ],
    "linesTraditional": [
      "王濬樓船下益州，金陵王氣黯然收。",
      "千尋鐵鎖沈江底，一片降旛出石頭。",
      "人世幾回傷往事，山形依舊枕寒流。",
      "從今四海為家日，故壘蕭蕭蘆荻秋。"
    ],
