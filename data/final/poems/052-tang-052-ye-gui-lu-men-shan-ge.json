    "id": "tang-052-ye-gui-lu-men-shan-ge",
    "order": 52,
    "section": "七言古诗",
    "title": "夜归鹿门山歌",
    "titleTraditional": "夜歸鹿門山歌",
    "author": "孟浩然",
    "authorTraditional": "孟浩然",
    "dynasty": "唐代",
    "aliases": [
      "夜归鹿门山歌 / 夜归鹿门歌",
      "夜归鹿门山歌"
    ],
    "lines": [
      "山寺钟鸣昼已昏，渔梁渡头争渡喧；",
      "人随沙路向江村，余亦乘舟归鹿门。",
      "鹿门月照开烟树，忽到庞公栖隐处；",
      "岩扉松径长寂寥，惟有幽人自来去。"
    ],
    "linesTraditional": [
      "山寺鐘鳴晝已昏，漁梁渡頭爭渡喧；",
      "人隨沙路向江村，餘亦乘舟歸鹿門。",
      "鹿門月照開煙樹，忽到龐公棲隱處；",
      "巖扉松徑長寂寥，惟有幽人自來去。"
    ],
