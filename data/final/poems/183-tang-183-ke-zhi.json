    "section": "七言律诗",
    "title": "客至",
    "titleTraditional": "客至",
    "author": "杜甫",
    "authorTraditional": "杜甫",
    "dynasty": "唐代",
    "aliases": [
      "客至"
    ],
    "lines": [
      "舍南舍北皆春水，但见群鸥日日来。",
      "花径不曾缘客扫，蓬门今始为君开。",
      "盘飧市远无兼味，樽酒家贫只旧醅。",
      "肯与邻翁相对饮，隔篱呼取尽余杯。"
    ],
    "linesTraditional": [
      "舍南舍北皆春水，但見群鷗日日來。",
      "花徑不曾緣客掃，蓬門今始為君開。",
      "盤飧市遠無兼味，樽酒家貧只舊醅。",
      "肯與鄰翁相對飲，隔籬呼取盡餘杯。"
    ],
