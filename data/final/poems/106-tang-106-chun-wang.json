    "dynasty": "唐代",
    "aliases": [
      "春望"
    ],
    "lines": [
      "国破山河在，城春草木深。",
      "感时花溅泪，恨别鸟惊心。",
      "烽火连三月，家书抵万金。",
      "白头搔更短，浑欲不胜簪。"
    ],
    "linesTraditional": [
      "國破山河在，城春草木深。",
      "感時花濺淚，恨別鳥驚心。",
      "烽火連三月，家書抵萬金。",
      "白頭搔更短，渾欲不勝簪。"
    ],
