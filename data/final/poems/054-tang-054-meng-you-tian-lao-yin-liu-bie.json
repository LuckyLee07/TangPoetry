      {
        "source": "唐诗三百首.json",
        "text": "四万--一作 ：一万"
      },
      {
        "source": "唐诗三百首.json",
        "text": "度--通 ：渡"
      },
      {
        "source": "chiuinan",
        "text": "1.瀛洲：东海神仙居所。"
      },
      {
        "source": "chiuinan",
        "text": "2.剡：音\"眼\"。"
      },
      {
        "source": "chiuinan",
        "text": "3.天鸡：山禽。"
      },
      {
        "source": "chiuinan",
        "text": "4.青云梯：登山石阶。"
      },
      {
        "source": "chiuinan",
        "text": "5.谢公：指谢灵运。"
      },
      {
        "source": "chiuinan",
        "text": "6.列缺：天隙电光。"
      },
      {
        "source": "chiuinan",
        "text": "7.訇：音\"轰\"，大声。"
      },
      {
        "source": "chiuinan",
        "text": "8.怳：音\"谎\"，惊。"
      }
    ],
