    "notes": [
      {
        "source": "chiuinan",
        "text": "1.日角：天庭中骨起，状如日。用称帝王异相。"
      },
      {
        "source": "chiuinan",
        "text": "2.陈后主：南北朝时陈宣帝子，荒淫无度，隋师至，与孔师二妃匿于胭"
      },
      {
        "source": "chiuinan",
        "text": "脂井，被俘送长安。"
      },
      {
        "source": "chiuinan",
        "text": "3.后庭花：曲名，陈后主为宫人所制。"
      }
    ],
