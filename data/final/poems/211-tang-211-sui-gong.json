    "id": "tang-211-sui-gong",
    "order": 211,
    "section": "七言律诗",
    "title": "隋宫",
    "titleTraditional": "隋宮",
    "author": "李商隐",
    "authorTraditional": "李商隱",
    "dynasty": "唐代",
    "aliases": [
      "隋宫"
    ],
    "lines": [
      "紫泉宫殿锁烟霞，欲取芜城作帝家。",
      "玉玺不缘归日角，锦帆应是到天涯。",
      "于今腐草无萤火，终古垂杨有暮鸦。",
      "地下若逢陈后主，岂宜重问后庭花？"
    ],
    "linesTraditional": [
      "紫泉宮殿鎖煙霞，欲取蕪城作帝家。",
      "玉璽不緣歸日角，錦帆應是到天涯。",
      "於今腐草無螢火，終古垂楊有暮鴉。",
      "地下若逢陳後主，豈宜重問後庭花？"
    ],
