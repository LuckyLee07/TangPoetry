    "lines": [
      "明朝驿使发，一夜絮征袍。",
      "素手抽针冷，那堪把剪刀。",
      "裁缝寄远道，几日到临洮。"
    ],
    "linesTraditional": [
      "明朝驛使發，一夜絮征袍。",
      "素手抽鍼冷，那堪把剪刀。",
      "裁縫寄遠道，幾日到臨洮。"
    ],
