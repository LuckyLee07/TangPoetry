    "lines": [
      "早被婵娟误，欲妆临镜慵。",
      "承恩不在貌，教妾若为容？",
      "风暖鸟声碎，日高花影重。",
      "年年越溪女，相忆采芙蓉。"
    ],
    "linesTraditional": [
      "早被嬋娟誤，欲妝臨鏡慵。",
      "承恩不在貌，教妾若為容？",
      "風暖鳥聲碎，日高花影重。",
      "年年越溪女，相憶採芙蓉。"
    ],
