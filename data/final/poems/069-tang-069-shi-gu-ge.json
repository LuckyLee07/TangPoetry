    "notes": [
      {
        "source": "chiuinan",
        "text": "1.少陵、谪仙：杜甫、李白。"
      },
      {
        "source": "chiuinan",
        "text": "2.搜：音\"搜\"，春猎。"
      },
      {
        "source": "chiuinan",
        "text": "3.遮罗：拦截网罗。"
      },
      {
        "source": "chiuinan",
        "text": "4.镌功：功名刻石。"
      },
      {
        "source": "chiuinan",
        "text": "5.隳：音\"灰\"，毁。"
      },
      {
        "source": "chiuinan",
        "text": "6.㧑呵：指挥呵斥。㧑，音\"灰\"。"
      },
      {
        "source": "chiuinan",
        "text": "7.凤翥：凤舞。翥，音\"祝\"。"
      },
      {
        "source": "chiuinan",
        "text": "8.二雅：诗经大雅、小雅。"
      },
      {
        "source": "chiuinan",
        "text": "9.委蛇：宽舒貌。"
      },
      {
        "source": "chiuinan",
        "text": "10.掎摭：引取。"
      },
      {
        "source": "chiuinan",
        "text": "11.羲娥：日月。羲为羲和，日御；娥为嫦娥，月御。"
      },
      {
        "source": "chiuinan",
        "text": "12.媕婀：不决貌。"
      },
      {
        "source": "chiuinan",
        "text": "13.摩挲：顾惜。"
      },
      {
        "source": "chiuinan",
        "text": "14.丘轲：孔丘、孟轲。"
      }
    ],
