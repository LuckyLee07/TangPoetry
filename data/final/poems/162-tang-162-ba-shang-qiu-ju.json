    "title": "灞上秋居",
    "titleTraditional": "灞上秋居",
    "author": "马戴",
    "authorTraditional": "馬戴",
    "dynasty": "唐代",
    "aliases": [
      "灞上秋居"
    ],
    "lines": [
      "灞原风雨定，晚见雁行频。",
      "落叶他乡树，寒灯独夜人。",
      "空园白露滴，孤壁野僧邻。",
      "寄卧郊扉久，何年致此身？"
    ],
    "linesTraditional": [
      "灞原風雨定，晚見雁行頻。",
      "落葉他鄉樹，寒燈獨夜人。",
      "空園白露滴，孤壁野僧鄰。",
      "寄臥郊扉久，何年致此身？"
    ],
