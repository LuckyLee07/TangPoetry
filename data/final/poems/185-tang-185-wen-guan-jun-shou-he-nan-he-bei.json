    "section": "七言律诗",
    "title": "闻官军收河南河北",
    "titleTraditional": "聞官軍收河南河北",
    "author": "杜甫",
    "authorTraditional": "杜甫",
    "dynasty": "唐代",
    "aliases": [
      "闻官军收河南河北"
    ],
    "lines": [
      "剑外忽传收蓟北，初闻涕泪满衣裳。",
      "却看妻子愁何在？",
      "漫卷诗书喜欲狂。",
      "白日放歌须纵酒，青春作伴好还乡。",
      "即从巴峡穿巫峡，便下襄阳向洛阳。"
    ],
    "linesTraditional": [
      "劍外忽傳收薊北，初聞涕淚滿衣裳。",
      "卻看妻子愁何在？",
      "漫卷詩書喜欲狂。",
      "白日放歌須縱酒，青春作伴好還鄉。",
      "即從巴峽穿巫峽，便下襄陽向洛陽。"
    ],
