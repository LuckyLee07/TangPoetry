    "lines": [
      "慈母手中线，游子身上衣；",
      "临行密密缝，意恐迟迟归。",
      "谁言寸草心，报得三春辉？"
    ],
    "linesTraditional": [
      "慈母手中線，遊子身上衣；",
      "臨行密密縫，意恐遲遲歸。",
      "誰言寸草心，報得三春輝？"
    ],
