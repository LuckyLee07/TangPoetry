    "title": "山居秋暝",
    "titleTraditional": "山居秋暝",
    "author": "王维",
    "authorTraditional": "王維",
    "dynasty": "唐代",
    "aliases": [
      "山居秋暝"
    ],
    "lines": [
      "空山新雨后，天气晚来秋。",
      "明月松间照，清泉石上流。",
      "竹喧归浣女，莲动下渔舟。",
      "随意春芳歇，王孙自可留。"
    ],
    "linesTraditional": [
      "空山新雨後，天氣晚來秋。",
      "明月松間照，清泉石上流。",
      "竹喧歸浣女，蓮動下漁舟。",
      "隨意春芳歇，王孫自可留。"
    ],
