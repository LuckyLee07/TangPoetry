    "id": "tang-172-wang-ji-men",
    "order": 172,
    "section": "七言律诗",
    "title": "望蓟门",
    "titleTraditional": "望薊門",
    "author": "祖咏",
    "authorTraditional": "祖詠",
    "dynasty": "唐代",
    "aliases": [
      "望蓟门"
    ],
    "lines": [
      "燕台一去客心惊，箫鼓喧喧汉将营。",
      "万里寒光生积雪，三边曙色动危旌。",
      "沙场烽火侵胡月，海畔云山拥蓟城。",
      "少小虽非投笔吏，论功还欲请长缨。"
    ],
    "linesTraditional": [
      "燕臺一去客心驚，簫鼓喧喧漢將營。",
      "萬里寒光生積雪，三邊曙色動危旌。",
      "沙場烽火侵胡月，海畔雲山擁薊城。",
      "少小雖非投筆吏，論功還欲請長纓。"
    ],
