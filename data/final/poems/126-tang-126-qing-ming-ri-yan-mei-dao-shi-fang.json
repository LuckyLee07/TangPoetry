    "title": "清明日宴梅道士房",
    "titleTraditional": "清明日宴梅道士房",
    "author": "孟浩然",
    "authorTraditional": "孟浩然",
    "dynasty": "唐代",
    "aliases": [
      "清明日宴梅道士房"
    ],
    "lines": [
      "林卧愁春尽，开轩览物华。",
      "忽逢青鸟使，邀入赤松家。",
      "丹灶初开火，仙桃正发花。",
      "童颜若可驻，何惜醉流霞。"
    ],
    "linesTraditional": [
      "林臥愁春盡，開軒覽物華。",
      "忽逢青鳥使，邀入赤松家。",
      "丹灶初開火，仙桃正發花。",
      "童顏若可駐，何惜醉流霞。"
    ],
