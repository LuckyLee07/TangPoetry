    "notes": [
      {
        "source": "chiuinan",
        "text": "1.青鸟使：西王母使者，用称道家差遣的人。"
      },
      {
        "source": "chiuinan",
        "text": "2.金灶：炼丹的灶。"
      },
      {
        "source": "chiuinan",
        "text": "3.流霞：酒名，仙家所酿。"
      }
    ],
