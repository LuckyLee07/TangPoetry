    "title": "送李中丞归汉阳别业",
    "titleTraditional": "送李中丞歸漢陽別業",
    "author": "刘长卿",
    "authorTraditional": "劉長卿",
    "dynasty": "唐代",
    "aliases": [
      "送李中丞归汉阳别业"
    ],
    "lines": [
      "流落征南将，曾驱十万师。",
      "罢归无旧业，老去恋明时。",
      "独立三边静，轻生一剑知。",
      "茫茫江汉上，日暮复何之。"
    ],
    "linesTraditional": [
      "流落征南將，曾驅十萬師。",
      "罷歸無舊業，老去戀明時。",
      "獨立三邊靜，輕生一劍知。",
      "茫茫江漢上，日暮復何之。"
    ],
