    "section": "七言律诗",
    "title": "宿府",
    "titleTraditional": "宿府",
    "author": "杜甫",
    "authorTraditional": "杜甫",
    "dynasty": "唐代",
    "aliases": [
      "宿府"
    ],
    "lines": [
      "清秋幕府井梧寒，独宿江城蜡炬残。",
      "永夜角声悲自语，中天月色好谁看？",
      "风尘荏苒音书绝，关塞萧条行陆难。",
      "已忍伶俜十年事，强移栖息一枝安。",
      "又作路"
    ],
    "linesTraditional": [
      "清秋幕府井梧寒，獨宿江城蠟炬殘。",
      "永夜角聲悲自語，中天月色好誰看？",
      "風塵荏苒音書絕，關塞蕭條行陸難。",
      "已忍伶俜十年事，強移棲息一枝安。",
      "又作路"
    ],
