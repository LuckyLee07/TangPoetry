    "section": "七言律诗",
    "title": "黄鹤楼",
    "titleTraditional": "黃鶴樓",
    "author": "崔颢",
    "authorTraditional": "崔顥",
    "dynasty": "唐代",
    "aliases": [
      "黄鹤楼 / 登黄鹤楼",
      "黄鹤楼"
    ],
    "lines": [
      "昔人已乘黄鹤去，此地空余黄鹤楼。",
      "黄鹤一去不复返，白云千载空悠悠。",
      "晴川历历汉阳树，芳草萋萋鹦鹉洲。",
      "日暮乡关何处是？",
      "烟波江上使人愁。"
    ],
    "linesTraditional": [
      "昔人已乘黃鶴去，此地空餘黃鶴樓。",
      "黃鶴一去不復返，白雲千載空悠悠。",
      "晴川歷歷漢陽樹，芳草萋萋鸚鵡洲。",
      "日暮鄉關何處是？",
      "煙波江上使人愁。"
    ],
