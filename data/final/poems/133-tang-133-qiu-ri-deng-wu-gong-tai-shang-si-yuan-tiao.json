    "id": "tang-133-qiu-ri-deng-wu-gong-tai-shang-si-yuan-tiao",
    "order": 133,
    "section": "五言律诗",
    "title": "秋日登吴公台上寺远眺",
    "titleTraditional": "秋日登吳公臺上寺遠眺",
    "author": "刘长卿",
    "authorTraditional": "劉長卿",
    "dynasty": "唐代",
    "aliases": [
      "秋日登吴公台上寺远眺"
    ],
    "lines": [
      "古台摇落后，秋日望乡心。",
      "野寺人来少，云峰水隔深。",
      "夕阳依旧垒，寒磬满空林。",
      "惆怅南朝事，长江独至今。"
    ],
    "linesTraditional": [
      "古臺搖落後，秋日望鄉心。",
      "野寺人來少，雲峰水隔深。",
      "夕陽依舊壘，寒磬滿空林。",
      "惆悵南朝事，長江獨至今。"
    ],
    "text": "古台摇落后，秋日望乡心。野寺人来少，云峰水隔深。夕阳依旧垒，寒磬满空林。惆怅南朝事，长江独至今。",
