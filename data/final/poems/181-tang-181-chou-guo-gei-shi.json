    ],
    "lines": [
      "洞门高阁霭余辉，桃李阴阴柳絮飞。",
      "禁里疏钟官舍晚，省中啼鸟吏人稀。",
      "晨摇玉珮趋金殿，夕奉天书拜琐闱。",
      "强欲从君无那老，将因卧病解朝衣。"
    ],
    "linesTraditional": [
      "洞門高閣靄餘輝，桃李陰陰柳絮飛。",
      "禁裡疏鐘官舍晚，省中啼鳥吏人稀。",
      "晨搖玉珮趨金殿，夕奉天書拜瑣闈。",
      "強欲從君無那老，將因臥病解朝衣。"
    ],
