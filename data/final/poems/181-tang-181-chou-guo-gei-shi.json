    "id": "tang-181-chou-guo-gei-shi",
    "order": 181,
    "section": "七言律诗",
    "title": "酬郭给事",
    "titleTraditional": "酬郭給事",
    "author": "王维",
    "authorTraditional": "王維",
    "dynasty": "唐代",
