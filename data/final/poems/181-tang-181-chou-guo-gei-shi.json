    "notes": [
      {
        "source": "chiuinan",
        "text": "1.桃李：喻门生众多。"
      },
      {
        "source": "chiuinan",
        "text": "2.禁里：宫禁里面。"
      },
      {
        "source": "chiuinan",
        "text": "3.琐闱：宫门。"
      },
      {
        "source": "chiuinan",
        "text": "4.无那：无奈。"
      }
    ],
