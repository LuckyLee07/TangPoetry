    ],
    "lines": [
      "楚江微雨里，建业暮钟时。",
      "漠漠帆来重，冥冥鸟去迟。",
      "海门深不见，浦树远含滋。",
      "相送情无限，沾襟比散丝。"
    ],
    "linesTraditional": [
      "楚江微雨裡，建業暮鐘時。",
