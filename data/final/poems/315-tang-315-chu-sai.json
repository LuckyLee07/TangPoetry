    "lines": [
      "秦时明月汉时关，万里长征人未还。",
      "但使龙城飞将在，不教胡马渡阴山。"
    ],
    "linesTraditional": [
      "秦時明月漢時關，萬里長征人未還。",
      "但使龍城飛將在，不教胡馬渡陰山。"
    ],
