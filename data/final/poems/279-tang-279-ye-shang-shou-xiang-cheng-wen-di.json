    "lines": [
      "回乐峰前沙似雪，受降城外月如霜。",
      "不知何处吹芦管，一夜征人尽望乡。"
    ],
    "linesTraditional": [
      "回樂峰前沙似雪，受降城外月如霜。",
      "不知何處吹蘆管，一夜征人盡望鄉。"
    ],
