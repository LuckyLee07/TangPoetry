    "notes": [
      {
        "source": "chiuinan",
        "text": "1.袷衣：指夹衣。袷，音夹。"
      },
      {
        "source": "chiuinan",
        "text": "2.红楼：富女之居。"
      },
      {
        "source": "chiuinan",
        "text": "3.珠箔：珠帘。"
      },
      {
        "source": "chiuinan",
        "text": "4.晼晚：迟暮意。晼，音宛。"
      }
    ],
