    "id": "tang-216-chun-yu",
    "order": 216,
    "section": "七言律诗",
    "title": "春雨",
    "titleTraditional": "春雨",
    "author": "李商隐",
    "authorTraditional": "李商隱",
    "dynasty": "唐代",
    "aliases": [
      "春雨"
    ],
    "lines": [
      "怅卧新春白袷衣，白门寥落意多违。",
      "红楼隔雨相望冷，珠箔飘灯独自归。",
      "远路应悲春晼晚，残宵犹得梦依稀。",
      "玉珰缄札何由达，万里云罗一雁飞。"
    ],
    "linesTraditional": [
      "悵臥新春白袷衣，白門寥落意多違。",
      "紅樓隔雨相望冷，珠箔飄燈獨自歸。",
      "遠路應悲春晼晚，殘宵猶得夢依稀。",
      "玉璫緘札何由達，萬里雲羅一雁飛。"
    ],
