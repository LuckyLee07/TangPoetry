    "lines": [
      "兰叶春葳蕤，桂华秋皎洁；",
      "欣欣此生意，自尔为佳节。",
      "谁知林栖者？",
      "闻风坐相悦，草木有本心，何求美人折？"
    ],
    "linesTraditional": [
      "蘭葉春葳蕤，桂華秋皎潔；",
      "欣欣此生意，自爾為佳節。",
      "誰知林棲者？",
      "聞風坐相悅，草木有本心，何求美人折？"
    ],
