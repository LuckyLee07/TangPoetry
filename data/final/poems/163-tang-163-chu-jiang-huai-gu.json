    ],
    "lines": [
      "露气寒光集，微阳下楚丘。",
      "猿啼洞庭树，人在木兰舟。",
      "广泽生明月，苍山夹乱流。",
      "云中君不见，竟夕自悲秋。"
    ],
    "linesTraditional": [
      "露氣寒光集，微陽下楚丘。",
      "猿啼洞庭樹，人在木蘭舟。",
      "廣澤生明月，蒼山夾亂流。",
      "雲中君不見，竟夕自悲秋。"
    ],
