    ],
    "lines": [
      "摇落深知宋玉悲，风流儒雅亦吾师。",
      "怅望千秋一洒泪，萧条异代不同时。",
      "江山故宅空文藻，云雨荒台岂梦思。",
      "最是楚宫俱泯灭，舟人指点到今疑。"
    ],
    "linesTraditional": [
      "搖落深知宋玉悲，風流儒雅亦吾師。",
      "悵望千秋一灑淚，蕭條異代不同時。",
      "江山故宅空文藻，雲雨荒臺豈夢思。",
      "最是楚宮俱泯滅，舟人指點到今疑。"
    ],
