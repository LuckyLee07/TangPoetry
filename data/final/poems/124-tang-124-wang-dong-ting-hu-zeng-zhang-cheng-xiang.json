    ],
    "lines": [
      "八月湖水平，涵虚混太清。",
      "气蒸云梦泽，波撼岳阳城。",
      "欲济无舟楫，端居耻圣明。",
      "坐观垂钓者，空有羡鱼情。"
    ],
    "linesTraditional": [
      "八月湖水平，涵虛混太清。",
      "氣蒸雲夢澤，波撼岳陽城。",
      "欲濟無舟楫，端居恥聖明。",
      "坐觀垂釣者，空有羨魚情。"
    ],
