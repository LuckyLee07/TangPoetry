    "section": "七言律诗",
    "title": "登高",
    "titleTraditional": "登高",
    "author": "杜甫",
    "authorTraditional": "杜甫",
    "dynasty": "唐代",
    "aliases": [
      "登高"
    ],
    "lines": [
      "风急天高猿啸哀，渚清沙白鸟飞回。",
      "无边落木萧萧下，不尽长江滚滚来。",
      "万里悲秋常作客，百年多病独登台。",
      "艰难苦恨繁霜鬓，潦倒新停浊酒杯。"
    ],
    "linesTraditional": [
      "風急天高猿嘯哀，渚清沙白鳥飛迴。",
      "無邊落木蕭蕭下，不盡長江滾滾來。",
      "萬里悲秋常作客，百年多病獨登臺。",
      "艱難苦恨繁霜鬢，潦倒新停濁酒杯。"
    ],
