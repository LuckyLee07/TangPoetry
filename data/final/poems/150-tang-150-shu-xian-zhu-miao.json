      "蜀先主庙"
    ],
    "lines": [
      "天地英雄气，千秋尚凛然。",
      "势分三足鼎，业复五铢钱。",
      "得相能开国，生儿不象贤。",
      "凄凉蜀故妓，来舞魏宫前。"
    ],
    "linesTraditional": [
      "天地英雄氣，千秋尚凜然。",
      "勢分三足鼎，業復五銖錢。",
      "得相能開國，生兒不象賢。",
      "淒涼蜀故妓，來舞魏宮前。"
    ],
