    "notes": [
      {
        "source": "唐诗三百首.json",
        "text": "沈--通 ：沉"
      },
      {
        "source": "chiuinan",
        "text": "1.蔡女：即汉朝蔡文姬，作胡笳十八拍。"
      },
      {
        "source": "chiuinan",
        "text": "2.飒飒：音\"萨\"，风声。"
      },
      {
        "source": "chiuinan",
        "text": "3.呦呦：音\"忧\"，鹿呜声。"
      },
      {
        "source": "chiuinan",
        "text": "4.掖垣：音\"夜元\"，宫殿旁垣。"
      },
      {
        "source": "chiuinan",
        "text": "5.凤凰池：禁苑中池沼。"
      },
      {
        "source": "chiuinan",
        "text": "6.青琐门：宫门。"
      },
      {
        "source": "chiuinan",
        "text": "7.脱略：不拘束。"
      }
    ],
