    "title": "没蕃故人",
    "titleTraditional": "沒蕃故人",
    "author": "张籍",
    "authorTraditional": "張籍",
    "dynasty": "唐代",
    "aliases": [
      "没蕃故人"
    ],
    "lines": [
      "前年伐月支，城下没全师。",
      "蕃汉断消息，死生长别离。",
      "无人收废帐，归马识残旗。",
      "欲祭疑君在，天涯哭此时。"
    ],
    "linesTraditional": [
      "前年伐月支，城下沒全師。",
      "蕃漢斷消息，死生長別離。",
      "無人收廢帳，歸馬識殘旗。",
      "欲祭疑君在，天涯哭此時。"
    ],
