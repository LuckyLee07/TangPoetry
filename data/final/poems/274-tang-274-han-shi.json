    "lines": [
      "春城无处不飞花，寒食东风御柳斜。",
      "日暮汉宫传蜡烛，轻烟散入五侯家。"
    ],
    "linesTraditional": [
      "春城無處不飛花，寒食東風禦柳斜。",
      "日暮漢宮傳蠟燭，輕煙散入五侯家。"
    ],
