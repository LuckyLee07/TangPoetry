    ],
    "lines": [
      "一丘尝欲卧，三径苦无资。",
      "北土非吾愿，东林怀我师。",
      "黄金燃桂尽，壮志逐年衰。",
      "日夕凉风至，闻蝉但益悲。"
    ],
    "linesTraditional": [
      "一丘嘗欲臥，三徑苦無資。",
      "北土非吾願，東林懷我師。",
      "黃金燃桂盡，壯志逐年衰。",
      "日夕涼風至，聞蟬但益悲。"
    ],
