    "lines": [
      "云想衣裳花想容，春风拂槛露华浓。",
      "若非群玉山头见，会向瑶台月下逢。"
    ],
    "linesTraditional": [
      "雲想衣裳花想容，春風拂檻露華濃。",
      "若非群玉山頭見，會向瑤臺月下逢。"
    ],
