    "aliases": [
      "无题·飒飒东风细雨来",
      "无题之二"
    ],
    "lines": [
      "飒飒东风细雨来，芙蓉塘外有轻雷。",
      "金蟾啮璅烧香入，玉虎牵丝汲井回。",
      "贾氏窥帘韩掾少，宓妃留枕魏王才。",
      "春心莫共花争发，一寸想思一寸灰。"
    ],
    "linesTraditional": [
      "颯颯東風細雨來，芙蓉塘外有輕雷。",
      "金蟾齧璅燒香入，玉虎牽絲汲井迴。",
      "賈氏窺簾韓掾少，宓妃留枕魏王才。",
      "春心莫共花爭發，一寸想思一寸灰。"
    ],
