    "title": "九日登望仙台呈刘明府",
    "titleTraditional": "九日登望仙臺呈劉明府",
    "author": "崔曙",
    "authorTraditional": "崔曙",
    "dynasty": "唐代",
    "aliases": [
      "九日登望仙台呈刘明府容",
      "九日登望仙台呈刘明府"
    ],
    "lines": [
      "汉文皇帝有高台，此日登临曙色开。",
      "三晋云山皆北向，二陵风雨自东来。",
      "关门令尹谁能识？",
      "河上仙翁去不回，且欲竟寻彭泽宰，陶然共醉菊花杯。"
    ],
    "linesTraditional": [
      "漢文皇帝有高臺，此日登臨曙色開。",
      "三晉雲山皆北向，二陵風雨自東來。",
      "關門令尹誰能識？",
      "河上仙翁去不回，且欲竟尋彭澤宰，陶然共醉菊花杯。"
    ],
