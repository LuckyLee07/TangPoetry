    ],
    "lines": [
      "海上生明月，天涯共此时。",
      "情人怨遥夜，竟夕起相思。",
      "灭烛怜光满，披衣觉露滋。",
      "不堪盈手赠，还寝梦佳期。"
    ],
    "linesTraditional": [
      "海上生明月，天涯共此時。",
      "情人怨遙夜，竟夕起相思。",
      "滅燭憐光滿，披衣覺露滋。",
      "不堪盈手贈，還寢夢佳期。"
    ],
