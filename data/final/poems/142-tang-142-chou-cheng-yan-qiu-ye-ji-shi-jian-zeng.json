    "aliases": [
      "酬程延秋夜即事见赠"
    ],
    "lines": [
      "长簟迎风早，空城澹月华。",
      "星河秋一雁，砧杵夜千家。",
      "节候看应晚，心期卧亦赊。",
      "向来吟秀句，不觉已鸣鸦。"
    ],
    "linesTraditional": [
      "長簟迎風早，空城澹月華。",
      "星河秋一雁，砧杵夜千家。",
      "節候看應晚，心期臥亦賒。",
      "向來吟秀句，不覺已鳴鴉。"
    ],
