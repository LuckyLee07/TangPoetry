    "id": "tang-189-ge-ye",
    "order": 189,
    "section": "七言律诗",
    "title": "阁夜",
    "titleTraditional": "閣夜",
    "author": "杜甫",
    "authorTraditional": "杜甫",
    "dynasty": "唐代",
    "aliases": [
      "阁夜"
    ],
    "lines": [
      "岁暮阴阳催短景，天涯霜雪霁寒霄。",
      "五更鼓角声悲壮，三峡星河影动摇。",
      "野哭千家闻战伐，夷歌数处起渔樵。",
      "卧龙跃马终黄土，人事音书漫寂寥。"
    ],
    "linesTraditional": [
      "歲暮陰陽催短景，天涯霜雪霽寒霄。",
      "五更鼓角聲悲壯，三峽星河影動搖。",
      "野哭千家聞戰伐，夷歌數處起漁樵。",
      "臥龍躍馬終黃土，人事音書漫寂寥。"
    ],
