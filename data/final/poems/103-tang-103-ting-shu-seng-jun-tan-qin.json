    ],
    "lines": [
      "蜀僧抱绿绮，西下峨眉峰；",
      "为我一挥手，如听万壑松。",
      "客心洗流水，余响入霜钟。",
      "不觉碧山暮，秋云暗几重？"
    ],
    "linesTraditional": [
      "蜀僧抱綠綺，西下峨眉峰；",
      "為我一揮手，如聽萬壑松。",
      "客心洗流水，餘響入霜鐘。",
      "不覺碧山暮，秋雲暗幾重？"
    ],
