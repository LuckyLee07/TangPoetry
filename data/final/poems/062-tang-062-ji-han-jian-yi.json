    "notes": [
      {
        "source": "chiuinan",
        "text": "1.濯足：洗脚。濯，音\"卓\"。"
      },
      {
        "source": "chiuinan",
        "text": "2.八荒：八方荒远之地。"
      },
      {
        "source": "chiuinan",
        "text": "3.玉京：天帝居所。"
      },
      {
        "source": "chiuinan",
        "text": "4.翳：音\"意\"，掩蔽、驾御。"
      },
      {
        "source": "chiuinan",
        "text": "5.琼浆：美酒。"
      },
      {
        "source": "chiuinan",
        "text": "6.羽人：仙人。"
      },
      {
        "source": "chiuinan",
        "text": "7.赤松子：仙人名，神农时雨师。"
      },
      {
        "source": "chiuinan",
        "text": "8.南极老人：南极星。"
      },
      {
        "source": "chiuinan",
        "text": "8.玉堂：玉殿。"
      }
    ],
