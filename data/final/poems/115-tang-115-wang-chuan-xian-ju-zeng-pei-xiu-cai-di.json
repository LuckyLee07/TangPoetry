    "section": "五言律诗",
    "title": "辋川闲居赠裴秀才迪",
    "titleTraditional": "輞川閑居贈裴秀才迪",
    "author": "王维",
    "authorTraditional": "王維",
    "dynasty": "唐代",
    "aliases": [
      "辋川闲居赠裴秀才迪"
    ],
    "lines": [
      "寒山转苍翠，秋水日潺湲。",
      "倚杖柴门外，临风听暮蝉。",
      "渡头余落日，墟里上孤烟。",
      "复值接舆醉，狂歌五柳前。"
    ],
    "linesTraditional": [
      "寒山轉蒼翠，秋水日潺湲。",
      "倚杖柴門外，臨風聽暮蟬。",
      "渡頭餘落日，墟里上孤煙。",
      "復值接輿醉，狂歌五柳前。"
    ],
