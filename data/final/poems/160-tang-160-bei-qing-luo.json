    ],
    "lines": [
      "残阳西入崦，茅屋访孤僧。",
      "落叶人何在？",
      "寒云路几层。",
      "独敲初夜磬，闲倚一枝藤。",
      "世界微尘里，吾宁爱与憎。"
    ],
    "linesTraditional": [
      "殘陽西入崦，茅屋訪孤僧。",
      "落葉人何在？",
      "寒雲路幾層。",
      "獨敲初夜磬，閑倚一枝藤。",
      "世界微塵裡，吾寧愛與憎。"
    ],
