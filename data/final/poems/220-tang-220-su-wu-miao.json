    "section": "七言律诗",
    "title": "苏武庙",
    "titleTraditional": "蘇武廟",
    "author": "温庭筠",
    "authorTraditional": "溫庭筠",
    "dynasty": "唐代",
    "aliases": [
      "苏武庙"
    ],
    "lines": [
      "苏武魂销汉使前，古祠高树两茫然。",
      "云边雁断胡天月，陇上羊归塞草烟。",
      "回日楼台非甲帐，去时冠剑是丁年。",
      "茂陵不见封侯印，空向秋波哭逝川。"
    ],
    "linesTraditional": [
      "蘇武魂銷漢使前，古祠高樹兩茫然。",
      "雲邊雁斷胡天月，隴上羊歸塞草煙。",
      "迴日樓臺非甲帳，去時冠劍是丁年。",
      "茂陵不見封侯印，空向秋波哭逝川。"
    ],
