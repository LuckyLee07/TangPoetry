    "id": "tang-187-deng-lou",
    "order": 187,
    "section": "七言律诗",
    "title": "登楼",
    "titleTraditional": "登樓",
    "author": "杜甫",
    "authorTraditional": "杜甫",
    "dynasty": "唐代",
    "aliases": [
      "登楼"
    ],
    "lines": [
      "花近高楼伤客心，万方多难此登临。",
      "锦江春色来天地，玉垒浮云变古今。",
      "北极朝庭终不改，西山寇盗莫相侵。",
      "可怜后主还祠庙，日暮聊为梁父吟。"
    ],
    "linesTraditional": [
      "花近高樓傷客心，萬方多難此登臨。",
      "錦江春色來天地，玉壘浮雲變古今。",
      "北極朝庭終不改，西山寇盜莫相侵。",
      "可憐後主還祠廟，日暮聊為梁父吟。"
    ],
