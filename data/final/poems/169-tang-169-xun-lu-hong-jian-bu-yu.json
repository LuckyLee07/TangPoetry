    "id": "tang-169-xun-lu-hong-jian-bu-yu",
    "order": 169,
    "section": "五言律诗",
    "title": "寻陆鸿渐不遇",
    "titleTraditional": "尋陸鴻漸不遇",
    "author": "僧皎然",
    "authorTraditional": "僧皎然",
    "dynasty": "唐代",
    "aliases": [
      "寻陆鸿渐不遇"
    ],
    "lines": [
      "移家虽带郭，野径入桑麻。",
      "近种篱边菊，秋来未著花。",
      "扣门无犬吠，欲去问西家。",
      "报到山中去，归来每日斜。"
    ],
    "linesTraditional": [
      "移家雖帶郭，野徑入桑麻。",
      "近種籬邊菊，秋來未著花。",
      "扣門無犬吠，欲去問西家。",
      "報到山中去，歸來每日斜。"
    ],
