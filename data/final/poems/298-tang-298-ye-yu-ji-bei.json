    "lines": [
      "君问归期未有期，巴山夜雨涨秋池。",
      "何当共剪西窗烛，却话巴山夜雨时。"
    ],
    "linesTraditional": [
      "君問歸期未有期，巴山夜雨漲秋池。",
      "何當共剪西窗燭，卻話巴山夜雨時。"
    ],
