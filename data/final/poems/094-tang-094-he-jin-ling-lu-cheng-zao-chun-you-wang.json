    "section": "五言律诗",
    "title": "和晋陵路丞早春游望",
    "titleTraditional": "和晉陵路丞早春遊望",
    "author": "杜审言",
    "authorTraditional": "杜審言",
    "dynasty": "唐代",
    "aliases": [
      "和晋陵陆丞早春游望",
      "和晋陵路丞早春游望"
    ],
    "lines": [
      "独有宦游人，偏惊物候新。",
      "云霞出海曙，梅柳渡江春。",
      "淑气催黄鸟，晴光转绿苹。",
      "忽闻歌古调，归思欲沾巾。"
    ],
    "linesTraditional": [
      "獨有宦遊人，偏驚物候新。",
      "雲霞出海曙，梅柳渡江春。",
      "淑氣催黃鳥，晴光轉綠蘋。",
      "忽聞歌古調，歸思欲霑巾。"
    ],
