    "lines": [
      "道由白云尽，春与青溪长。",
      "时有落花至，远隋流水香。",
      "闲门向山路，深柳读书堂。",
      "幽映每白日，清辉照衣裳。",
      "又作闲"
    ],
    "linesTraditional": [
      "道由白雲盡，春與青溪長。",
      "時有落花至，遠隋流水香。",
      "閑門向山路，深柳讀書堂。",
      "幽映每白日，清輝照衣裳。",
      "又作閒"
    ],
