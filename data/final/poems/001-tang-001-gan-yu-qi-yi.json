    ],
    "lines": [
      "孤鸿海上来，池潢不敢顾；",
      "侧见双翠鸟，巢在三珠树。",
      "矫矫珍木巅，得无金丸惧？",
      "美服患人指，高明逼神恶。",
      "今我游冥冥，弋者何所慕？"
    ],
    "linesTraditional": [
      "孤鴻海上來，池潢不敢顧；",
      "側見雙翠鳥，巢在三珠樹。",
      "矯矯珍木巔，得無金丸懼？",
      "美服患人指，高明逼神惡。",
      "今我遊冥冥，弋者何所慕？"
    ],
