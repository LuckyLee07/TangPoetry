    "title": "酬张少府",
    "titleTraditional": "酬張少府",
    "author": "王维",
    "authorTraditional": "王維",
    "dynasty": "唐代",
    "aliases": [
      "酬张少府"
    ],
    "lines": [
      "晚年惟好静，万事不关心。",
      "自顾无长策，空知返旧林。",
      "松风吹解带，山月照弹琴。",
      "君问穷通理，渔歌入浦深。"
    ],
    "linesTraditional": [
      "晚年惟好靜，萬事不關心。",
      "自顧無長策，空知返舊林。",
      "松風吹解帶，山月照彈琴。",
      "君問窮通理，漁歌入浦深。"
    ],
