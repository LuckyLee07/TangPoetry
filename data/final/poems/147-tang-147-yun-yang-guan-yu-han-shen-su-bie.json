    ],
    "lines": [
      "故人江海别，几度隔山川。",
      "乍见翻疑梦，相悲各问年。",
      "孤灯寒照雨，深竹暗浮烟。",
      "更有明朝恨，离杯惜共传。"
    ],
    "linesTraditional": [
      "故人江海別，幾度隔山川。",
      "乍見翻疑夢，相悲各問年。",
      "孤燈寒照雨，深竹暗浮煙。",
      "更有明朝恨，離杯惜共傳。"
    ],
