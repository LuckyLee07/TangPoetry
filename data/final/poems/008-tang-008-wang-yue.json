    ],
    "lines": [
      "岱宗夫如何？",
      "齐鲁青未了。",
      "造化钟神秀，阴阳割昏晓。",
      "荡胸生层云，决眦入归鸟。",
      "会当凌绝顶，一览众山小。"
    ],
    "linesTraditional": [
      "岱宗夫如何？",
      "齊魯青未了。",
      "造化鍾神秀，陰陽割昏曉。",
      "盪胸生層雲，決眥入歸鳥。",
      "會當凌絕頂，一覽眾山小。"
    ],
