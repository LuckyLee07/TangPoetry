    "lines": [
      "客去波平槛，蝉休露满枝。",
      "永怀当此节，倚立自移时。",
      "北斗兼春远，南陵寓使迟。",
      "天涯占梦数，疑误有新知。"
    ],
    "linesTraditional": [
      "客去波平檻，蟬休露滿枝。",
