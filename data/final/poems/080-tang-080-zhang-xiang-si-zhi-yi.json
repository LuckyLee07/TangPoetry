    "notes": [
      {
        "source": "chiuinan",
        "text": "1.络纬：虫名，形似蚱蜢。"
      },
      {
        "source": "chiuinan",
        "text": "2.井阑：井上阑干。"
      },
      {
        "source": "chiuinan",
        "text": "3.青冥：色青而高远。"
      },
      {
        "source": "chiuinan",
        "text": "4.渌水：清水。渌，音\"路\"。"
      }
    ],
