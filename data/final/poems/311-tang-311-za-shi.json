    "lines": [
      "尽寒食雨草萋萋，著麦苗风柳映堤。",
      "等是有家归未得，杜鹃休向耳边啼。"
    ],
    "linesTraditional": [
      "盡寒食雨草萋萋，著麥苗風柳映堤。",
      "等是有家歸未得，杜鵑休向耳邊啼。"
    ],
