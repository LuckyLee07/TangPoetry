    ],
    "lines": [
      "昔日戏言身后事，今朝都到眼前来。",
      "衣裳已施行看尽，针线犹存未忍开。",
      "尚想旧情怜婢仆，也曾因梦送钱财。",
      "诚知此恨人人有，贫贱夫妻百事哀。"
    ],
    "linesTraditional": [
      "昔日戲言身後事，今朝都到眼前來。",
      "衣裳已施行看盡，針線猶存未忍開。",
      "尚想舊情憐婢僕，也曾因夢送錢財。",
      "誠知此恨人人有，貧賤夫妻百事哀。"
    ],
