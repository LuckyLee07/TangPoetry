    ],
    "lines": [
      "几行归塞尽，片影独何之？",
      "暮雨相呼失，寒塘欲下迟。",
      "渚云低暗渡，关月冷相随。",
      "未必逢矰缴，孤飞自可疑。"
    ],
    "linesTraditional": [
      "幾行歸塞盡，片影獨何之？",
      "暮雨相呼失，寒塘欲下遲。",
      "渚雲低暗渡，關月冷相隨。",
      "未必逢矰繳，孤飛自可疑。"
    ],
