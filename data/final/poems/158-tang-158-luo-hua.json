    "author": "李商隐",
    "authorTraditional": "李商隱",
    "dynasty": "唐代",
    "aliases": [
      "落花"
    ],
    "lines": [
      "高阁客竟去，小园花乱飞。",
      "参差连曲陌，迢递送斜晖。",
      "肠断未忍扫，眼穿仍欲归。",
      "芳心向春尽，所得是沾衣。"
    ],
    "linesTraditional": [
      "高閣客竟去，小園花亂飛。",
      "參差連曲陌，迢遞送斜暉。",
      "腸斷未忍掃，眼穿仍欲歸。",
      "芳心向春盡，所得是沾衣。"
    ],
