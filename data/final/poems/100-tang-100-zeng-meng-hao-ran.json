    "title": "赠孟浩然",
    "titleTraditional": "贈孟浩然",
    "author": "李白",
    "authorTraditional": "李白",
    "dynasty": "唐代",
    "aliases": [
      "赠孟浩然"
    ],
    "lines": [
      "吾爱孟夫子，风流天下闻。",
      "红颜弃轩冕，白首卧松云。",
      "醉月频中圣，迷花不事君。",
      "高山安可仰？",
      "徒此挹清芬。"
    ],
    "linesTraditional": [
      "吾愛孟夫子，風流天下聞。",
      "紅顏棄軒冕，白首臥松雲。",
      "醉月頻中聖，迷花不事君。",
      "高山安可仰？",
      "徒此挹清芬。"
    ],
