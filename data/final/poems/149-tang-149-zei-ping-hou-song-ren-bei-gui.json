      "贼平后送人北归"
    ],
    "lines": [
      "世乱同南去，时清独北还。",
      "他乡生白发，旧国见青山。",
      "晓月过残垒，繁星宿故关。",
      "寒禽与衰草，处处伴愁颜。"
    ],
    "linesTraditional": [
      "世亂同南去，時清獨北還。",
      "他鄉生白髮，舊國見青山。",
      "曉月過殘壘，繁星宿故關。",
      "寒禽與衰草，處處伴愁顏。"
    ],
