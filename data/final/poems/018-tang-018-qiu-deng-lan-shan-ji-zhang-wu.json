    ],
    "lines": [
      "北山白云里，隐者自怡悦；",
      "相望始登高，心随雁飞灭。",
      "愁因薄暮起，兴是清秋发。",
      "时见归村人，沙行渡头歇。",
      "天边树若荠，江畔洲如月。",
      "何当载酒来，共醉重阳节。"
    ],
    "linesTraditional": [
      "北山白雲裡，隱者自怡悅；",
      "相望始登高，心隨雁飛滅。",
      "愁因薄暮起，興是清秋發。",
      "時見歸村人，沙行渡頭歇。",
      "天邊樹若薺，江畔洲如月。",
      "何當載酒來，共醉重陽節。"
    ],
