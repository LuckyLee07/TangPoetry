      "过故人庄"
    ],
    "lines": [
      "故人具鸡黍，邀我至田家。",
      "绿树村边合，青山郭外斜。",
      "开轩面场圃，把酒话桑麻。",
      "待到重阳日，还来就菊花。"
    ],
    "linesTraditional": [
      "故人具雞黍，邀我至田家。",
      "綠樹村邊合，青山郭外斜。",
      "開軒面場圃，把酒話桑麻。",
      "待到重陽日，還來就菊花。"
    ],
