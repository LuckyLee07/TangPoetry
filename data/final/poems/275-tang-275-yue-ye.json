    ],
    "lines": [
      "更深月色半人家，北斗阑干南斗斜。",
      "今夜偏知春气暖，虫声新透绿窗沙。"
    ],
    "linesTraditional": [
      "更深月色半人家，北斗闌幹南斗斜。",
      "今夜偏知春氣暖，蟲聲新透綠窗沙。"
    ],
