    "title": "旅宿",
    "titleTraditional": "旅宿",
    "author": "杜牧",
    "authorTraditional": "杜牧",
    "dynasty": "唐代",
    "aliases": [
      "旅宿"
    ],
    "lines": [
      "旅馆无良伴，凝情自悄然。",
      "寒灯思旧事，断雁警愁眠。",
      "远梦归侵晓，家书到隔年。",
      "沧江好烟月，门系钓鱼船。"
    ],
    "linesTraditional": [
      "旅館無良伴，凝情自悄然。",
      "寒燈思舊事，斷雁警愁眠。",
      "遠夢歸侵曉，家書到隔年。",
      "滄江好煙月，門繫釣魚船。"
    ],
