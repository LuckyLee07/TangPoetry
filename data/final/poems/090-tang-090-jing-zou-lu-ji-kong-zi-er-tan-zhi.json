    "aliases": [
      "经邹鲁祭孔子而叹之"
    ],
    "lines": [
      "夫子何为者，栖栖一代中。",
      "地犹鄹氏邑，宅即鲁王宫。",
      "叹凤嗟身否，伤麟怨道穷。",
      "今看两楹奠，当与梦时同。"
    ],
    "linesTraditional": [
      "夫子何為者，棲棲一代中。",
      "地猶鄹氏邑，宅即魯王宮。",
      "歎鳳嗟身否，傷麟怨道窮。",
      "今看兩楹奠，當與夢時同。"
    ],
