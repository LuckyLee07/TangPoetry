  "poem": {
    "id": "tang-083-xing-lu-nan-zhi-er",
    "order": 83,
    "section": "乐府",
    "title": "行路难之二",
    "titleTraditional": "行路難之二",
    "author": "李白",
    "authorTraditional": "李白",
    "dynasty": "唐代",
    "aliases": [
      "行路难·其二",
      "行路难之二"
    ],
    "lines": [
      "大道如青天，我独不得出。",
      "羞逐长安社中儿，赤鸡白狗赌梨栗。",
      "弹剑作歌奏苦声，曳裾王门不称情。",
      "淮阴市井笑韩信，汉朝公卿忌贾生。",
      "君不见，昔时燕家重郭隗，拥篲折节无嫌猜；",
      "剧辛乐毅感恩分，输肝剖胆效英才。",
      "昭王白骨萦蔓草，谁人更扫黄金台？",
      "行路难，归去来？"
    ],
    "linesTraditional": [
      "大道如青天，我獨不得出。",
      "羞逐長安社中兒，赤雞白狗賭梨慄。",
      "彈劍作歌奏苦聲，曳裾王門不稱情。",
      "淮陰市井笑韓信，漢朝公卿忌賈生。",
      "君不見，昔時燕家重郭隗，擁篲折節無嫌猜；",
      "劇辛樂毅感恩分，輸肝剖膽效英才。",
      "昭王白骨縈蔓草，誰人更掃黃金臺？",
      "行路難，歸去來？"
    ],
