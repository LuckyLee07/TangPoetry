    "section": "五言古诗",
    "title": "同从弟南斋玩月忆山阴崔少府",
    "titleTraditional": "同從弟南齋翫月憶山陰崔少府",
    "author": "王昌龄",
    "authorTraditional": "王昌齡",
    "dynasty": "唐代",
    "aliases": [
      "同从弟南斋玩月忆山阴崔少府"
    ],
    "lines": [
      "高卧南斋时，开帷月初吐；",
      "清辉淡水木，演漾在窗户。",
      "苒苒几盈虚？",
      "澄澄变今古。",
      "美人清江畔，是夜越吟苦。",
      "千里其如何？",
      "微风吹兰杜。"
    ],
    "linesTraditional": [
      "高臥南齋時，開帷月初吐；",
      "清輝淡水木，演漾在窗戶。",
      "苒苒幾盈虛？",
      "澄澄變今古。",
      "美人清江畔，是夜越吟苦。",
      "千里其如何？",
      "微風吹蘭杜。"
    ],
