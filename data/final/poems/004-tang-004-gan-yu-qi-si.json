    "dynasty": "唐代",
    "aliases": [
      "感遇·江南有丹橘",
      "感遇其四"
    ],
    "lines": [
      "江南有丹橘，经冬犹绿林；",
      "岂伊地气暖？",
      "自有岁寒心。",
      "可以荐嘉客，奈何阻重深？",
      "运命惟所遇，循环不可寻。",
      "徒言树桃李，此木岂无阴？"
    ],
    "linesTraditional": [
      "江南有丹橘，經冬猶綠林；",
      "豈伊地氣暖？",
      "自有歲寒心。",
      "可以薦嘉客，奈何阻重深？",
      "運命惟所遇，循環不可尋。",
      "徒言樹桃李，此木豈無陰？"
    ],
