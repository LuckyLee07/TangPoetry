    ],
    "lines": [
      "清川带长薄，车马去闲闲。",
      "流水如有意，暮禽相与还。",
      "荒城临古渡，落日满秋山。",
      "迢递嵩高下，归来且闭关。"
    ],
    "linesTraditional": [
      "清川帶長薄，車馬去閑閑。",
      "流水如有意，暮禽相與還。",
      "荒城臨古渡，落日滿秋山。",
      "迢遞嵩高下，歸來且閉關。"
    ],
