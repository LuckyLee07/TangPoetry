    "title": "长安遇冯著",
    "titleTraditional": "長安遇馮著",
    "author": "韦应物",
    "authorTraditional": "韋應物",
    "dynasty": "唐代",
    "aliases": [
      "长安遇冯著"
    ],
    "lines": [
      "客从东方来，衣上灞陵雨。",
      "问客何为来？",
      "采山因买斧。",
      "冥冥花正开，飏飏燕新乳。",
      "昨别今已春，鬓丝生几缕。"
    ],
    "linesTraditional": [
      "客從東方來，衣上灞陵雨。",
      "問客何為來？",
      "採山因買斧。",
      "冥冥花正開，颺颺燕新乳。",
      "昨別今已春，鬢絲生幾縷。"
    ],
