    "id": "tang-171-xing-jing-hua-yin",
    "order": 171,
    "section": "七言律诗",
    "title": "行经华阴",
    "titleTraditional": "行經華陰",
    "author": "崔颢",
    "authorTraditional": "崔顥",
    "dynasty": "唐代",
    "aliases": [
      "行经华阴"
    ],
    "lines": [
      "岧峣太华俯咸京，天外三峰削不成。",
      "武帝祠前云欲散，仙人掌上雨初晴。",
      "河山北枕秦关险，驿树西连汉畤平。",
      "借问路傍名利客，无如此处学长生。"
    ],
    "linesTraditional": [
      "岧嶢太華俯咸京，天外三峰削不成。",
      "武帝祠前雲欲散，仙人掌上雨初晴。",
      "河山北枕秦關險，驛樹西連漢畤平。",
      "借問路傍名利客，無如此處學長生。"
    ],
