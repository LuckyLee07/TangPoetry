    "aliases": [
      "蝉"
    ],
    "lines": [
      "本以高难饱，徒劳恨费声。",
      "五更疏欲断，一树碧无情。",
      "薄宦梗犹泛，故园芜已平。",
      "烦君最相警，我亦举家清。"
    ],
    "linesTraditional": [
      "本以高難飽，徒勞恨費聲。",
      "五更疏欲斷，一樹碧無情。",
      "薄宦梗猶汎，故園蕪已平。",
      "煩君最相警，我亦舉家清。"
    ],
