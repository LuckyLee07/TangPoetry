    "notes": [
      {
        "source": "chiuinan",
        "text": "1.薄宦：俸禄微薄的小官。"
      },
      {
        "source": "chiuinan",
        "text": "2.梗犹泛：如萍梗的浮泛无定居。"
      },
      {
        "source": "chiuinan",
        "text": "3.举家清：举家清贫。"
      }
