    "id": "tang-197-zi-xia-kou-zhi-ying-zhou-xi-wang-yue-yang-ji-yuan-zhong-cheng",
    "order": 197,
    "section": "七言律诗",
    "title": "自夏口至鹦洲夕望岳阳寄源中丞",
    "titleTraditional": "自夏口至鸚洲夕望岳陽寄源中丞",
    "author": "刘长卿",
    "authorTraditional": "劉長卿",
    "dynasty": "唐代",
    "aliases": [
      "自夏口至鹦鹉洲夕望岳阳寄源中丞",
      "自夏口至鹦洲夕望岳阳寄源中丞"
    ],
    "lines": [
      "汀洲无浪复无烟，楚客相思益渺然。",
      "汉口夕阳斜渡鸟，洞庭秋水远连天。",
      "孤城背岭寒吹角，独戍临江夜泊船。",
      "贾谊上书忧汉室，长沙谪去古今怜。"
    ],
    "linesTraditional": [
      "汀洲無浪復無煙，楚客相思益渺然。",
      "漢口夕陽斜渡鳥，洞庭秋水遠連天。",
      "孤城背嶺寒吹角，獨戍臨江夜泊船。",
      "賈誼上書憂漢室，長沙謫去古今憐。"
    ],
