    ],
    "lines": [
      "夕阳度西岭，群壑倏已暝；",
      "松月生夜凉，风泉满清听。",
      "樵人归欲尽，烟鸟栖初定。",
      "之子期宿来，孤琴候萝径。"
    ],
    "linesTraditional": [
      "夕陽度西嶺，群壑倏已暝；",
      "松月生夜涼，風泉滿清聽。",
      "樵人歸欲盡，煙鳥棲初定。",
      "之子期宿來，孤琴候蘿徑。"
    ],
