    "lines": [
      "寂寂竟何待，朝朝空自归。",
      "欲寻芳草去，惜与故人违。",
      "当路谁相假，知音世所稀。",
      "祗应守寂寞，还掩故园扉。"
    ],
    "linesTraditional": [
      "寂寂竟何待，朝朝空自歸。",
      "欲尋芳草去，惜與故人違。",
      "當路誰相假，知音世所稀。",
      "祗應守寂寞，還掩故園扉。"
    ],
