    "title": "与诸子登岘山",
    "titleTraditional": "與諸子登峴山",
    "author": "孟浩然",
    "authorTraditional": "孟浩然",
    "dynasty": "唐代",
    "aliases": [
      "与诸子登岘山"
    ],
    "lines": [
      "人事有代谢，往来成古今。",
      "江山留胜迹，我辈复登临。",
      "水落鱼梁浅，天寒梦泽深。",
      "羊公碑字在，读罢泪沾襟。"
    ],
    "linesTraditional": [
      "人事有代謝，往來成古今。",
      "江山留勝跡，我輩復登臨。",
      "水落魚梁淺，天寒夢澤深。",
      "羊公碑字在，讀罷淚沾襟。"
    ],
