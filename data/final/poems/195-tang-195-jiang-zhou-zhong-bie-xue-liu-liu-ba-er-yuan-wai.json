    "aliases": [
      "江州重别薛六柳八二员外"
    ],
    "lines": [
      "生涯岂料承优诏？",
      "世事空知学醉歌。",
      "江上月明胡雁过，淮南木落楚山多。",
      "寄身且喜沧洲近，顾影无如白发何！",
      "今日龙钟人共老，媿君犹遣慎风波。"
    ],
    "linesTraditional": [
      "生涯豈料承優詔？",
      "世事空知學醉歌。",
      "江上月明胡雁過，淮南木落楚山多。",
      "寄身且喜滄洲近，顧影無如白髮何！",
      "今日龍鐘人共老，媿君猶遣慎風波。"
    ],
