    "title": "登岳阳楼",
    "titleTraditional": "登岳陽樓",
    "author": "杜甫",
    "authorTraditional": "杜甫",
    "dynasty": "唐代",
    "aliases": [
      "登岳阳楼"
    ],
    "lines": [
      "昔闻洞庭水，今上岳阳楼。",
      "吴楚东南坼，乾坤日夜浮。",
      "亲朋无一字，老病有孤舟。",
      "戎马关山北，凭轩涕泗流。"
    ],
    "linesTraditional": [
      "昔聞洞庭水，今上岳陽樓。",
      "吳楚東南坼，乾坤日夜浮。",
      "親朋無一字，老病有孤舟。",
      "戎馬關山北，憑軒涕泗流。"
    ],
