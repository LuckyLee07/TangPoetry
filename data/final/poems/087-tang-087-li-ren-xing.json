    "notes": [
      {
        "source": "chiuinan",
        "text": "1.蹙金：用金线绣衣。"
      },
      {
        "source": "chiuinan",
        "text": "2.翠微：裴翠。"
      },
      {
        "source": "chiuinan",
        "text": "3.□叶：妇女髻上的花饰。"
      },
      {
        "source": "chiuinan",
        "text": "4.腰衱：裙拖。衱，音\"劫\"。"
      },
      {
        "source": "chiuinan",
        "text": "5.椒房：后妃。"
      },
      {
        "source": "chiuinan",
        "text": "6.虢：音\"国\"。"
      },
      {
        "source": "chiuinan",
        "text": "7.素鳞：鲜鱼。"
      },
      {
        "source": "chiuinan",
        "text": "8.餍饫：饱食。"
      },
      {
        "source": "chiuinan",
        "text": "9.黄门：太监。"
      },
      {
        "source": "chiuinan",
        "text": "10.飞鞚：形容马跑得快。"
