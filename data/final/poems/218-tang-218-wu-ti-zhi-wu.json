    "aliases": [
      "无题·重帏深下莫愁堂",
      "无题之五"
    ],
    "lines": [
      "重帷深下莫愁堂，卧后清宵细细长。",
      "神女生涯原是梦，小姑居处本无郎。",
      "风波不信菱枝弱，月露谁教桂叶香。",
      "直道相思了无益，未妨惆怅是清狂。"
    ],
    "linesTraditional": [
      "重帷深下莫愁堂，臥後清宵細細長。",
      "神女生涯原是夢，小姑居處本無郎。",
      "風波不信菱枝弱，月露誰教桂葉香。",
      "直道相思了無益，未妨惆悵是清狂。"
    ],
