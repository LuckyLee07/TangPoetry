    "id": "tang-093-zai-yu-yong-chan-bing-xu",
    "order": 93,
    "section": "五言律诗",
    "title": "在狱咏蝉并序",
    "titleTraditional": "在獄詠蟬並序",
    "author": "骆宾王",
    "authorTraditional": "駱賓王",
    "dynasty": "唐代",
    "aliases": [
      "咏蝉 / 在狱咏蝉",
