  "poem": {
    "id": "tang-198-zeng-que-xia-pei-she-ren",
    "order": 198,
    "section": "七言律诗",
    "title": "赠阙下裴舍人",
    "titleTraditional": "贈闕下裴舍人",
    "author": "钱起",
    "authorTraditional": "錢起",
    "dynasty": "唐代",
    "aliases": [
      "赠阙下裴舍人"
    ],
    "lines": [
      "二月黄鹂飞上林，春城紫禁晓阴阴。",
      "长乐钟声花外尽，龙池柳色雨中深。",
      "阳和不散穷途恨，霄汉长怀捧日心。",
      "献赋十年犹未遇，羞将白发对华簪。"
    ],
    "linesTraditional": [
      "二月黃鸝飛上林，春城紫禁曉陰陰。",
      "長樂鐘聲花外盡，龍池柳色雨中深。",
      "陽和不散窮途恨，霄漢長懷捧日心。",
      "獻賦十年猶未遇，羞將白髮對華簪。"
    ],
