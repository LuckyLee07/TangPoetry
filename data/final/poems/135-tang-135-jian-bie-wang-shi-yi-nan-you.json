    "aliases": [
      "饯别王十一南游"
    ],
    "lines": [
      "望君烟水阔，挥手泪沾巾。",
      "飞鸟没何处？",
      "青山空向人。",
      "长江一帆远，落日五湖春。",
      "谁见汀洲上，相思愁白苹？"
    ],
    "linesTraditional": [
      "望君煙水闊，揮手淚霑巾。",
      "飛鳥沒何處？",
      "青山空向人。",
      "長江一帆遠，落日五湖春。",
      "誰見汀洲上，相思愁白蘋？"
    ],
