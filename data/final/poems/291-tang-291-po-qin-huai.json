    "lines": [
      "烟笼寒水月笼沙，夜泊秦淮近酒家。",
      "商女不知亡国恨，隔江犹唱后庭花。"
    ],
    "linesTraditional": [
      "煙籠寒水月籠沙，夜泊秦淮近酒家。",
      "商女不知亡國恨，隔江猶唱後庭花。"
    ],
