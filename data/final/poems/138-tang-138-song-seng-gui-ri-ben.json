    "title": "送僧归日本",
    "titleTraditional": "送僧歸日本",
    "author": "钱起",
    "authorTraditional": "錢起",
    "dynasty": "唐代",
    "aliases": [
      "送僧归日本"
    ],
    "lines": [
      "上国随缘住，来途若梦行。",
      "浮天沧海远，去世法舟轻。",
      "水月通禅寂，鱼龙听梵声。",
      "惟怜一灯影，万里眼中明。"
    ],
    "linesTraditional": [
      "上國隨緣住，來途若夢行。",
      "浮天滄海遠，去世法舟輕。",
      "水月通禪寂，魚龍聽梵聲。",
      "惟憐一燈影，萬里眼中明。"
    ],
