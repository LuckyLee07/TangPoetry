    ],
    "lines": [
      "红叶晚萧萧，长亭酒一瓢。",
      "残云归太华，疏雨过中条。",
      "树色随山迥，河声入海遥。",
      "帝乡明日到，犹自梦渔樵。"
    ],
    "linesTraditional": [
      "紅葉晚蕭蕭，長亭酒一瓢。",
      "殘雲歸太華，疏雨過中條。",
      "樹色隨山迥，河聲入海遙。",
      "帝鄉明日到，猶自夢漁樵。"
    ],
