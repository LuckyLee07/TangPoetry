  "poem": {
    "id": "tang-047-gu-yi",
    "order": 47,
    "section": "七言古诗",
    "title": "古意",
    "titleTraditional": "古意",
    "author": "李颀",
    "authorTraditional": "李頎",
    "dynasty": "唐代",
    "aliases": [
      "古意"
    ],
    "lines": [
      "男儿事长征，少小幽燕客，赌胜马蹄下，由来轻七尺；",
      "杀人莫敢前，须如猬毛磔。",
      "黄云陇底白雪飞，未得报恩不能归。",
      "辽东小妇年十五，惯弹琵琶解歌舞，今为羌笛出塞声，使我三军泪如雨。"
    ],
    "linesTraditional": [
      "男兒事長征，少小幽燕客，賭勝馬蹄下，由來輕七尺；",
      "殺人莫敢前，鬚如蝟毛磔。",
      "黃雲隴底白雪飛，未得報恩不能歸。",
      "遼東小婦年十五，慣彈琵琶解歌舞，今為羌笛出塞聲，使我三軍淚如雨。"
    ],
