    "aliases": [
      "咏怀古迹五首·其三",
      "咏怀古迹五首之三"
    ],
    "lines": [
      "群山万壑赴荆门，生长明妃尚有村。",
      "一去紫台连朔漠，独留青冢向黄昏。",
      "画图省识春风面，环珮空归月下魂。",
      "千载琵琶作胡语，分明怨恨曲中论。"
    ],
    "linesTraditional": [
      "群山萬壑赴荊門，生長明妃尚有村。",
      "一去紫臺連朔漠，獨留青塚向黃昏。",
      "畫圖省識春風面，環珮空歸月下魂。",
      "千載琵琶作胡語，分明怨恨曲中論。"
    ],
