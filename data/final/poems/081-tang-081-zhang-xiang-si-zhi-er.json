  "poem": {
    "id": "tang-081-zhang-xiang-si-zhi-er",
    "order": 81,
    "section": "乐府",
    "title": "长相思之二",
    "titleTraditional": "長相思之二",
    "author": "李白",
    "authorTraditional": "李白",
    "dynasty": "唐代",
    "aliases": [
      "长相思·其二",
      "长相思之二"
    ],
    "lines": [
      "日色已尽花含烟，月明欲素愁不眠。",
      "赵瑟初停凤凰柱，蜀琴欲奏鸳鸯弦。",
      "此曲有意无人传，愿随春风寄燕然。",
      "忆君迢迢隔青天，昔日横波目，今成流泪泉。",
      "不信妾肠断，归来看取明镜前。"
    ],
    "linesTraditional": [
      "日色已盡花含煙，月明欲素愁不眠。",
      "趙瑟初停鳳凰柱，蜀琴欲奏鴛鴦絃。",
      "此曲有意無人傳，願隨春風寄燕然。",
      "憶君迢迢隔青天，昔日橫波目，今成流淚泉。",
      "不信妾腸斷，歸來看取明鏡前。"
    ],
