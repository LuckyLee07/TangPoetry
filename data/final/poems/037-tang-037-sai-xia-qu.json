    ],
    "lines": [
      "饮马渡秋水，水寒风似刀。",
      "平沙日未没，黯黯见临洮。",
      "昔日长城战，咸言意气高；",
      "黄尘足今古，白骨乱蓬蒿。"
    ],
    "linesTraditional": [
      "飲馬渡秋水，水寒風似刀。",
      "平沙日未沒，黯黯見臨洮。",
      "昔日長城戰，咸言意氣高；",
      "黃塵足今古，白骨亂蓬蒿。"
    ],
