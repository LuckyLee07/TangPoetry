    "notes": [
      {
        "source": "chiuinan",
        "text": "1.王右军：即王羲之。"
      },
      {
        "source": "chiuinan",
        "text": "2.丹青：图画。"
      },
      {
        "source": "chiuinan",
        "text": "3.凌烟：阁名，贞观十七年，图功臣于其阁。"
      },
      {
        "source": "chiuinan",
        "text": "4.褒公：即段志玄。"
      },
      {
        "source": "chiuinan",
        "text": "5.鄂公：即尉迟敬德。"
      },
      {
        "source": "chiuinan",
        "text": "6.墀：音\"池\"，阶上的平地。"
      },
      {
        "source": "chiuinan",
        "text": "7.阊阖：音\"昌合\"，紫薇宫门名。"
      },
      {
        "source": "chiuinan",
        "text": "8.九重：称帝王居所。"
      },
      {
        "source": "chiuinan",
        "text": "9.玉花：即玉花骢，玄宗良马。"
      },
      {
        "source": "chiuinan",
        "text": "10.圉人、太仆：掌养马事官名。圉，音\"雨\"。"
      },
      {
        "source": "chiuinan",
        "text": "11.骅骝：音\"华留\"，古良马名。"
      },
      {
        "source": "chiuinan",
        "text": "12.坎𡒄：穷困、境遇不顺。𡒄，音\"览\"。"
      }
    ],
