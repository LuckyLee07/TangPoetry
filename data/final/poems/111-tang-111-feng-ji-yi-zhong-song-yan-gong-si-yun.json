    ],
    "lines": [
      "远送从此别，青山空复情。",
      "几时杯重把，昨夜月同行。",
      "列郡讴歌惜，三朝出入荣。",
      "将村独归处，寂寞养残生。"
    ],
    "linesTraditional": [
      "遠送從此別，青山空復情。",
      "幾時杯重把，昨夜月同行。",
      "列郡謳歌惜，三朝出入榮。",
      "將村獨歸處，寂寞養殘生。"
    ],
