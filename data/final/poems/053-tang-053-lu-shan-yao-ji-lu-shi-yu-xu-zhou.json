    "notes": [
      {
        "source": "chiuinan",
        "text": "1.楚狂：即陆通，字接舆，楚昭王时人，佯狂不仕。"
      },
      {
        "source": "chiuinan",
        "text": "2.黛：深青色。"
      },
      {
        "source": "chiuinan",
        "text": "3.金阙：天帝居所。"
      },
      {
        "source": "chiuinan",
        "text": "4.谢公：南北朝末谢灵运，好遨游山水。"
      },
      {
        "source": "chiuinan",
        "text": "5.琴心三叠：琴，和也；叠，积也；存三丹田，使和积如一。"
      },
      {
        "source": "chiuinan",
        "text": "6.玉京：元始天尊居所。"
      },
      {
        "source": "chiuinan",
        "text": "7.汗漫：广茫无际。"
      },
      {
        "source": "chiuinan",
        "text": "8.九垓：九天之外。"
      },
      {
        "source": "chiuinan",
        "text": "9.卢敖：秦时隐士。"
      },
      {
        "source": "chiuinan",
        "text": "10.太清：三清之一，仙人所居。"
      }
    ],
