      "客夜与故人偶集 / 江乡故人偶集客舍",
      "江乡故人偶集客舍"
    ],
    "lines": [
      "天秋月又满，城阙夜千重。",
      "还作江南会，翻疑梦里逢。",
      "风枝惊暗鹊，露草覆寒虫。",
      "羁旅长堪醉，相留畏晓钟。"
    ],
    "linesTraditional": [
      "天秋月又滿，城闕夜千重。",
      "還作江南會，翻疑夢裡逢。",
      "風枝驚暗鵲，露草覆寒蟲。",
      "羈旅長堪醉，相留畏曉鐘。"
    ],
