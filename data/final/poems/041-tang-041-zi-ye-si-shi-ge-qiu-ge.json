    "lines": [
      "长安一片月，万户捣衣声；",
      "秋风吹不尽，总是玉关情。",
      "何日平胡虏？",
      "良人罢远征。"
    ],
    "linesTraditional": [
      "長安一片月，萬戶擣衣聲；",
      "秋風吹不盡，總是玉關情。",
      "何日平胡虜？",
      "良人罷遠征。"
    ],
