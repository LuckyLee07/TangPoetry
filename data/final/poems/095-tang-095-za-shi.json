    ],
    "lines": [
      "闻道黄龙戍，频年不解兵。",
      "可怜闺里月，长在汉家营。",
      "少妇今春意，良人昨夜情。",
      "谁能将旗鼓，一为取龙城？"
    ],
    "linesTraditional": [
      "聞道黃龍戍，頻年不解兵。",
      "可憐閨裡月，長在漢家營。",
      "少婦今春意，良人昨夜情。",
      "誰能將旗鼓，一為取龍城？"
    ],
