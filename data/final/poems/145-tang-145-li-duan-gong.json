    "lines": [
      "故关衰草遍，离别正堪悲。",
      "路出寒云外，人归暮雪时。",
      "少孤为客早，多难识君迟。",
      "掩泪空相向，风尘何处期。"
    ],
    "linesTraditional": [
      "故關衰草遍，離別正堪悲。",
      "路出寒雲外，人歸暮雪時。",
      "少孤為客早，多難識君遲。",
      "掩淚空相向，風塵何處期。"
    ],
