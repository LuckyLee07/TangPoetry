    "id": "tang-049-qin-ge",
    "order": 49,
    "section": "七言古诗",
    "title": "琴歌",
    "titleTraditional": "琴歌",
    "author": "李颀",
    "authorTraditional": "李頎",
    "dynasty": "唐代",
    "aliases": [
      "琴歌"
    ],
    "lines": [
      "主人有酒欢今夕，请奏鸣琴广陵客。",
      "月照城头乌半飞，霜凄万树风入衣；",
      "铜𬬻华烛烛增辉，初弹渌水后楚妃。",
      "一声已动物皆静，四座无言星欲稀。",
      "清淮奉使千余里，敢告云山从此始。"
    ],
    "linesTraditional": [
      "主人有酒歡今夕，請奏鳴琴廣陵客。",
      "月照城頭烏半飛，霜淒萬樹風入衣；",
      "銅鑪華燭燭增輝，初彈淥水後楚妃。",
      "一聲已動物皆靜，四座無言星欲稀。",
      "清淮奉使千餘里，敢告雲山從此始。"
    ],
