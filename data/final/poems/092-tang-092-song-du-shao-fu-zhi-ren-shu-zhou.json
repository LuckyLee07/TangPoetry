    "lines": [
      "城阙辅三秦，风烟望五津。",
      "与君离别意，同是宦游人。",
      "海内存知己，天涯若比邻。",
      "无为在歧路，儿女共沾巾。"
    ],
    "linesTraditional": [
      "城闕輔三秦，風煙望五津。",
      "與君離別意，同是宦遊人。",
      "海內存知己，天涯若比鄰。",
      "無為在歧路，兒女共沾巾。"
    ],
