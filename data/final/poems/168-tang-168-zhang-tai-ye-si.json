    "title": "章台夜思",
    "titleTraditional": "章臺夜思",
    "author": "韦庄",
    "authorTraditional": "韋莊",
    "dynasty": "唐代",
    "aliases": [
      "章台夜思"
    ],
    "lines": [
      "清瑟怨遥夜，绕弦风雨哀。",
      "孤灯闻楚角，残月下章台。",
      "芳草已云暮，故人殊未来。",
      "乡书不可寄，秋雁又南回。"
    ],
    "linesTraditional": [
      "清瑟怨遙夜，繞絃風雨哀。",
      "孤燈聞楚角，殘月下章臺。",
      "芳草已雲暮，故人殊未來。",
      "鄉書不可寄，秋雁又南迴。"
    ],
