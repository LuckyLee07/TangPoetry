    "author": "岑参",
    "authorTraditional": "岑參",
    "dynasty": "唐代",
    "aliases": [
      "逢入京使"
    ],
    "lines": [
      "故园东望路漫漫，双袖龙钟泪不干。",
      "马上相逢无纸笔，凭君传语报平安。"
    ],
    "linesTraditional": [
      "故園東望路漫漫，雙袖龍鐘淚不乾。",
      "馬上相逢無紙筆，憑君傳語報平安。"
    ],
