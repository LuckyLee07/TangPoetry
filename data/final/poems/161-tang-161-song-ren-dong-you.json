    ],
    "lines": [
      "荒戍落黄叶，浩然离故关。",
      "高风汉阳渡，初日郢门山。",
      "江上几人在？",
      "天涯孤棹还。",
      "何当重相见？",
      "樽酒慰离颜。"
    ],
    "linesTraditional": [
      "荒戍落黃葉，浩然離故關。",
      "高風漢陽渡，初日郢門山。",
      "江上幾人在？",
      "天涯孤棹還。",
      "何當重相見？",
      "樽酒慰離顏。"
    ],
