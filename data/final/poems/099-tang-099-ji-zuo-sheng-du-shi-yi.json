      "寄左省杜拾遗"
    ],
    "lines": [
      "联步趋丹陛，分曹限紫微。",
      "晓随天仗入，暮惹御香归。",
      "白发悲花落，青云羡鸟飞。",
      "圣朝无阙事，自觉谏书稀。"
    ],
    "linesTraditional": [
      "聯步趨丹陛，分曹限紫微。",
      "曉隨天仗入，暮惹禦香歸。",
      "白髮悲花落，青雲羨鳥飛。",
      "聖朝無闕事，自覺諫書稀。"
    ],
