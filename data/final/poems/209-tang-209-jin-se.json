      "锦瑟"
    ],
    "lines": [
      "锦瑟无端五十弦，一弦一柱思华年。",
      "庄生晓梦迷蝴蝶，望帝春心托杜鹃。",
      "沧海月明珠有泪，蓝田日暖玉生烟。",
      "此情可待成追忆，只是当时已惘然。"
    ],
    "linesTraditional": [
      "錦瑟無端五十絃，一絃一柱思華年。",
      "莊生曉夢迷蝴蝶，望帝春心託杜鵑。",
      "滄海月明珠有淚，藍田日暖玉生煙。",
      "此情可待成追憶，只是當時已惘然。"
    ],
