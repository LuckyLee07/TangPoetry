    "id": "tang-178-he-jia-she-ren-zao-chao-da-ming-gong-zhi-zuo",
    "order": 178,
    "section": "七言律诗",
    "title": "和贾舍人早朝大明宫之作",
    "titleTraditional": "和賈舍人早朝大明宮之作",
    "author": "王维",
    "authorTraditional": "王維",
    "dynasty": "唐代",
    "aliases": [
      "和贾舍人早朝大明宫之作"
    ],
    "lines": [
      "绛帻鸡人送晓筹，尚衣方进翠云裘。",
      "九天阊阖开宫殿，万国衣冠拜冕旒。",
      "日色才临仙掌动，香烟欲傍衮龙浮。",
      "朝罢须裁五色诏，珮声归向凤池头。"
    ],
    "linesTraditional": [
      "絳幘雞人送曉籌，尚衣方進翠雲裘。",
      "九天閶闔開宮殿，萬國衣冠拜冕旒。",
      "日色纔臨仙掌動，香煙欲傍袞龍浮。",
      "朝罷須裁五色詔，珮聲歸向鳳池頭。"
    ],
