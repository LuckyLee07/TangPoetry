    "lines": [
      "镜湖三百里，菡萏发荷花。",
      "五月西施采，人看隘若耶。",
      "回舟不待月，归去越王家。"
    ],
    "linesTraditional": [
      "鏡湖三百里，菡萏發荷花。",
      "五月西施採，人看隘若耶。",
      "回舟不待月，歸去越王家。"
    ],
