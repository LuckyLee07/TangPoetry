    "aliases": [
      "淮上喜会梁川故人 / 淮上喜会梁州故人",
      "淮上喜会梁川故人"
    ],
    "lines": [
      "江汉曾为客，相逢每醉还。",
      "浮云一别后，流水十年间。",
      "欢笑情如旧，萧疏鬓已斑。",
      "何因北归去？",
      "淮上对秋山。"
    ],
    "linesTraditional": [
      "江漢曾為客，相逢每醉還。",
      "浮雲一別後，流水十年間。",
      "歡笑情如舊，蕭疏鬢已斑。",
      "何因北歸去？",
      "淮上對秋山。"
    ],
