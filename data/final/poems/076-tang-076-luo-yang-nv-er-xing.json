    "notes": [
      {
        "source": "chiuinan",
        "text": "1.玉勒：玉制的马络头。"
      },
      {
        "source": "chiuinan",
        "text": "2.骢马：雄健的马。"
      },
      {
        "source": "chiuinan",
        "text": "3.七香车：华贵的车。"
      },
      {
        "source": "chiuinan",
        "text": "4.季伦：晋朝石崇，富可敌国。"
      },
      {
        "source": "chiuinan",
        "text": "5.璅：音\"琐\"，细小。"
      },
      {
        "source": "chiuinan",
        "text": "6.越女：指西施。"
      }
