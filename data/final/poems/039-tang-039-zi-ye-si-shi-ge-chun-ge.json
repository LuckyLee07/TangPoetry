    "lines": [
      "秦地罗敷女，采桑绿水边。",
      "素手青条上，红妆白日鲜。",
      "蚕饥妾欲去，五马莫留连。"
    ],
    "linesTraditional": [
      "秦地羅敷女，採桑綠水邊。",
      "素手青條上，紅妝白日鮮。",
      "蠶飢妾欲去，五馬莫留連。"
    ],
