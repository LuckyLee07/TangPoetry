    "title": "月夜忆舍弟",
    "titleTraditional": "月夜憶舍弟",
    "author": "杜甫",
    "authorTraditional": "杜甫",
    "dynasty": "唐代",
    "aliases": [
      "月夜忆舍弟"
    ],
    "lines": [
      "戍鼓断人行，秋边一雁声。",
      "露从今夜白，月是故乡明。",
      "有弟皆分散，无家问死生。",
      "寄书长不达，况乃未休兵。"
    ],
    "linesTraditional": [
      "戍鼓斷人行，秋邊一雁聲。",
      "露從今夜白，月是故鄉明。",
      "有弟皆分散，無家問死生。",
      "寄書長不達，況乃未休兵。"
    ],
