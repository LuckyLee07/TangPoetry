    "lines": [
      "春眠不觉晓，处处闻啼鸟。",
      "夜来风雨声，花落知多少。"
    ],
    "linesTraditional": [
      "春眠不覺曉，處處聞啼鳥。",
      "夜來風雨聲，花落知多少。"
