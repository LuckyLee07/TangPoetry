    ],
    "lines": [
      "落帆逗淮镇，停舫临孤驿。",
      "浩浩风起波，冥冥日沈夕。",
      "人归山郭暗，雁下芦洲白。",
      "独夜忆秦关，听钟未眠客。"
    ],
    "linesTraditional": [
      "落帆逗淮鎮，停舫臨孤驛。",
      "浩浩風起波，冥冥日沈夕。",
      "人歸山郭暗，雁下蘆洲白。",
      "獨夜憶秦關，聽鐘未眠客。"
    ],
