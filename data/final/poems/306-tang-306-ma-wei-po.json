    ],
    "lines": [
      "玄宗回马杨妃死，云雨难忘日月新。",
      "终是圣明天子事，景阳宫井又何人。"
    ],
    "linesTraditional": [
      "玄宗回馬楊妃死，雲雨難忘日月新。",
      "終是聖明天子事，景陽宮井又何人。"
    ],
