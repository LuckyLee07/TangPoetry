    "lines": [
      "幽人归独卧，滞虑洗孤清，持此谢高鸟，因之传远情。",
      "日夕怀空意，人谁感至精？",
      "飞沈理自隔，何所慰吾诚？"
    ],
    "linesTraditional": [
      "幽人歸獨臥，滯慮洗孤清，持此謝高鳥，因之傳遠情。",
      "日夕懷空意，人誰感至精？",
      "飛沈理自隔，何所慰吾誠？"
    ],
