    "lines": [
      "调角断清秋，征人倚戍楼。",
      "春风对青冢，白日落梁州。",
      "大漠无兵阻，穷边有客游。",
      "蕃情似此水，长愿向南流。"
    ],
    "linesTraditional": [
      "調角斷清秋，征人倚戍樓。",
      "春風對青塚，白日落梁州。",
      "大漠無兵阻，窮邊有客遊。",
      "蕃情似此水，長願向南流。"
    ],
