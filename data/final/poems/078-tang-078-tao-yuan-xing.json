    "notes": [
      {
        "source": "chiuinan",
        "text": "1.津：渡。"
      },
      {
        "source": "chiuinan",
        "text": "2.红树：桃花。"
      },
      {
        "source": "chiuinan",
        "text": "3.隈隩：言山口曲而深。隩，音\"寓\"。"
      },
      {
        "source": "chiuinan",
        "text": "4.攒：聚。"
      },
      {
        "source": "chiuinan",
        "text": "5.栊：音\"龙\"，窗牖。"
      },
      {
        "source": "chiuinan",
        "text": "6.平明：天初明。"
      },
      {
        "source": "chiuinan",
        "text": "7.游衍：恣意出游。衍，音\"眼\"。"
      }
