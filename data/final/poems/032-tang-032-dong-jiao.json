    "id": "tang-032-dong-jiao",
    "order": 32,
    "section": "五言古诗",
    "title": "东郊",
    "titleTraditional": "東郊",
    "author": "韦应物",
    "authorTraditional": "韋應物",
    "dynasty": "唐代",
    "aliases": [
      "东郊"
    ],
    "lines": [
      "吏舍跼终年，出郊旷清曙。",
      "杨柳散和风，青山澹吾虑。",
      "依丛适自憩，缘涧还复去。",
      "微雨霭芳原，春鸠鸣何处？",
      "乐幽心屡止，遵事迹犹遽；",
      "终罢斯结庐，慕陶真可庶。"
    ],
    "linesTraditional": [
      "吏舍跼終年，出郊曠清曙。",
      "楊柳散和風，青山澹吾慮。",
      "依叢適自憩，緣澗還復去。",
      "微雨靄芳原，春鳩鳴何處？",
      "樂幽心屢止，遵事跡猶遽；",
      "終罷斯結廬，慕陶真可庶。"
    ],
