    "notes": [
      {
        "source": "chiuinan",
        "text": "1.溯：音\"诉\"，同溯，逆流而上。"
      },
      {
        "source": "chiuinan",
        "text": "2.无恃：指无母。"
      },
      {
        "source": "chiuinan",
        "text": "3.贻：音\"宜\"，遗留。"
      },
      {
        "source": "chiuinan",
        "text": "4.令门：善良人家。"
      },
      {
        "source": "chiuinan",
        "text": "5.资从：嫁粧。"
      },
      {
        "source": "chiuinan",
        "text": "6.缨：帽带。"
      }
