    "notes": [
      {
        "source": "chiuinan",
        "text": "1.大荒：空旷荒凉的大陆。"
      },
      {
        "source": "chiuinan",
        "text": "2.飐：音展，吹动。"
      },
      {
        "source": "chiuinan",
        "text": "3.薜荔：香草，缘木而生。薜，音必。"
      },
      {
        "source": "chiuinan",
        "text": "4.文身：纹身。"
      }
    ],
