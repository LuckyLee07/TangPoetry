    ],
    "lines": [
      "一路经行处，莓苔见履痕。",
      "白云依静渚，春草闭闲门。",
      "过雨看松色，随山到水源。",
      "溪花与禅意，相对亦忘言。"
    ],
    "linesTraditional": [
      "一路經行處，莓苔見履痕。",
      "白雲依靜渚，春草閉閑門。",
      "過雨看松色，隨山到水源。",
      "溪花與禪意，相對亦忘言。"
    ],
