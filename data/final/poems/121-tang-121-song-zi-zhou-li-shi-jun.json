    "aliases": [
      "送梓州李使君"
    ],
    "lines": [
      "万壑树参天，千山响杜鹃。",
      "山中一夜雨，树杪百重泉。",
      "汉女输橦布，巴人讼芋田。",
      "文翁翻教授，不敢倚先贤。"
    ],
    "linesTraditional": [
      "萬壑樹參天，千山響杜鵑。",
      "山中一夜雨，樹杪百重泉。",
      "漢女輸橦布，巴人訟芋田。",
      "文翁翻教授，不敢倚先賢。"
    ],
