    ],
    "lines": [
      "凉风起天末，君子意如何。",
      "鸿雁几时到，江湖秋水多。",
      "文章憎命达，魑魅喜人过。",
      "应共冤魂语，投诗赠汨罗。"
    ],
    "linesTraditional": [
      "涼風起天末，君子意如何。",
      "鴻雁幾時到，江湖秋水多。",
      "文章憎命達，魑魅喜人過。",
      "應共冤魂語，投詩贈汨羅。"
    ],
